#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
# ==================================================================================================
# AUFTRAG-mega61 BLOCK M — DAS TOR HATTE ZWEI WAHRHEITEN.
# ==================================================================================================
#
# DER BEFUND (bens GELB aus sammel57): Seit mega59 fuhr DIESES Skript den Web-Typprüfer. Die
# GitHub-CI ruft aber `npm run build` (.github/workflows/ci.yml), und das Wurzelskript war weiter
# nur `tsc --noEmit` über `services` und `tests`; der Docker-Build fährt ohnehin nur `vite build`,
# und `vite build` typprüft nicht. Lokal war das Tor also STRENGER als in der CI — genau die Sorte
# „bei mir war es grün", die niemand nachvollziehen kann.
#
# DIE LÖSUNG, UND WARUM DIESE: Die drei Typprüfläufe stehen jetzt in `npm run build`
# (package.json), und dieses Skript RUFT SIE AUF, statt sie zu wiederholen. Damit gibt es genau
# EINE Definition des Typtors, und sie liegt dort, wo die CI sie ohnehin abholt. Der umgekehrte Weg
# — die CI ruft `./tools/check` — wäre schlechter: die CI fährt ihre Schritte einzeln, damit ein
# roter Schritt beim Namen genannt wird, und der UI-Smoke aus `tools/check` gehört dort nicht hin.
#
# BEWUSST KEIN `references`-Umbau der Wurzel-Konfiguration: sie ist absichtlich Node-rein, ohne DOM
# und ohne JSX. Der Web-Typecheck braucht beides und bringt es in seiner EIGENEN Config mit.
npm run --silent build

# AUFTRAG-mega8 Block B: echter Produktions-Build der Oberfläche — derselbe Befehl, den der
# webbuild-Stage im Dockerfile fährt. Vorher lief im Gate NUR tsc; ein Bündel-Fehler von rollup
# (fehlendes Modul, kaputtes Plugin, Syntax, die tsc passieren lässt) fiel erst im Coolify-Deploy
# auf. Kosten: rund 4 Sekunden. Das Ergebnis landet in apps/web/dist (gitignored, verschmutzt den
# Baum also nicht).
# EINSCHRÄNKUNG, bewusst benannt: hier liegt das ganze Repo, im Container nur apps/web. Ein Import
# über die Modulgrenze nach services/ löst deshalb LOKAL auf und würde hier NICHT auffallen — genau
# diese Klasse fängt der Scan in tests/capture/draft-limits-shared.test.ts ab.
#
# ==================================================================================================
# AUFTRAG-mega59 BLOCK G — DAS PRÜFTOR WAR AN DER WEBOBERFLÄCHE BLIND.
# ==================================================================================================
#
# DER BEFUND, nachgerechnet: `vite build` typprüft NICHT — es transpiliert über esbuild. Die
# Wurzel-Config hat `"include": ["services", "tests"]`; `apps` steht nicht darin, Web-Dateien kamen
# also nur über IMPORTE AUS TESTS ins Programm. Über die transitive Hülle waren 344 von 389 Dateien
# erreicht — 45 NICHT, und darunter lag der ganze Rahmen: main.tsx, App.tsx, routes.tsx,
# ErrorBoundary, die drei Anmeldeschirme, acht ganze Seiten und der komplette Intake-Teilbaum. Ein
# Typfehler in pages/MyTasks.tsx machte nichts rot, und wir meldeten „komplett grün".
#
# DIE ÄNDERUNG IST EINE ZEILE und gleichwertig zu `npm --prefix apps/web run build`
# (apps/web/package.json: `tsc --noEmit && vite build`) — der Befehl, den der Container ohnehin fährt.
# BEWUSST KEIN `references`-Umbau der Wurzel-Config: sie ist absichtlich Node-rein, ohne DOM und ohne
# JSX. Der Web-Typecheck braucht beides und bringt es in seiner EIGENEN Config mit.
(cd apps/web && npx vite build)
