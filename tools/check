#!/usr/bin/env bash
# tools/check — Gesamtgate: Build + Lint + Architektur + Tests. Nur grün = lieferbar.
set -euo pipefail
# aufnahme:20260922:gesamt-prueftor-einheitlich: das Startverzeichnis des Aufrufers wird festgehalten,
# BEVOR das Tor sich an seiner Wurzel verankert — der Bericht am Ende nennt beide.
PRUEF_START="$PWD"
cd "$(dirname "$0")/.."
# Stufenbuch und Bericht (tools/pruefstufen.sh): jede Stufe unten beginnt mit `stufe <name>`, und
# die Namen stehen in tools/pruefvertrag.json — demselben Vertrag, den der CI-Job `check` über
# diesen Aufruf fährt. Fällt das Tor, nennt der Bericht die Stufe, das Bestandene, das nicht mehr
# Erreichte, den geprüften Quellstand und was dieses Tor gar nicht fährt.
source tools/pruefstufen.sh
# JOB 943 (Register I14): der cwd-Vertrag steht VOR allem anderen — er kostet Millisekunden und
# beantwortet die Frage, ob die folgenden Schritte überhaupt am richtigen Bestand arbeiten. Er ist
# fail-closed: eine markerlose oder gleichnamige falsche Wurzel bricht hier ab, statt sie zu raten.
stufe cwd-vertrag;  node tools/check-cwd-contract.mjs || { echo "✖ cwd-Vertrag verletzt"; exit 1; }
stufe build;        ./tools/build
stufe lint;         ./tools/lint
stufe architecture; npx depcruise --config .dependency-cruiser.cjs services || { echo "✖ Architekturregeln verletzt"; exit 1; }
# JOB 2008 D2 (Register A17): die Modalgrenzen-Erhebung lief bis hierher NUR im Test.
# Sie steht jetzt in tools/modalgrenze.ts und wird HIER gerufen — ein Aufrufer im Produkt.
stufe modalgrenze;  ./tools/modalgrenze.sh || { echo "✖ Modalgrenze verletzt"; exit 1; }
# JOB 2065 D4/D5 (Register I39): der Zentralen-Waechter hat HIER seinen Aufrufer. Bis D3 gab es ein
# lauffaehiges Werkzeug, das niemand rief — derselbe Fall wie `wissensnetzLuecken` und
# `erhebeVerweise`: gebaut, richtig, und wirkungslos.
#
# ER MELDET, ER SPERRT NUR DORT, WO JEMAND BEHEBEN DARF. D4 hat mit vier echten Funden das Tor rot
# gemacht und musste zurueckgerollt werden: die Fundstelle war `_relay/board/klarwerk-board.html`,
# ein Kontrollwerkzeug, das niemand anfassen darf. Ein rotes Tor haelt zwoelf Bahnen an, und ein
# Waechter, dessen Befund niemand beheben darf, wird abgeschaltet — dann meldet gar nichts mehr.
#
# DIE ZWEI KLASSEN UNTERSCHEIDET DER FUNDORT, nicht die Art des Fundes (tools/zentrale-drift.ts,
# `istUnantastbar`): was unter `_relay/` liegt, wird GEMELDET (Code 0, mit Adresse „Board — bei
# Pedi"); ein Fund an einer aenderbaren Stelle SPERRT (Code 1). Code 2 heisst „Lesefläche nicht
# da, nichts gemessen" — der Normalfall in jedem Clone, denn `_relay/` steht in `.gitignore:25`.
stufe zentrale-drift; zentrale_rc=0; ./tools/zentrale-drift.sh || zentrale_rc=$?
if [ "$zentrale_rc" = "1" ]; then echo "✖ Drift an einer aenderbaren Lesefläche"; exit 1; fi
# R-1405 (Bens Befund zu nacharbeit-2): Code 2 läuft weiter, ist aber KEINE Messung — das Stufenbuch
# führt die Stufe dann als „nicht gemessen“ statt als bestanden. Jeder andere unerwartete Code ebenso.
case "$zentrale_rc" in 0) ;; 2) stufe_status nicht-gemessen "Lesefläche nicht da, Code 2" ;; *) stufe_status nicht-gemessen "unerwarteter Code $zentrale_rc" ;; esac
# Aufnahme 20260922 · R-1303/R-1982 (N6)/R-2190: liegt dieser Arbeitsbaum unter einer Dateisync?
# Erkannt an der WIRKUNG (byte-identische ` 2`-Duplikate, auch in `.git`; ausgelagerte Dateien),
# nie am Pfad — s. tools/arbeitsordner-diagnose.ts. Zugriffsfehler und freier Platz stehen mit da.
#
# ER MELDET UND SPERRT NIE. Die Abhilfe ist ein Umzug des Arbeitsbaums, und den entscheidet der
# Mensch („nichts geschieht von selbst“, Onboarding). Ein Tor, das deswegen rot wird, hielte jede
# Bahn auf dem betroffenen Rechner an, ohne dass sie es beheben darf — derselbe Fehler wie
# zentrale-drift D4. Der Befund steht deshalb laut in der Torausgabe, der Rueckgabewert nicht im Tor.
stufe arbeitsordner-diagnose; bash tools/arbeitsordner-diagnose.sh || echo "  ⓘ gemeldet, nicht gesperrt"
# R-1420 (F-1420, secrets-management.md §10): Zugangsdaten gelangen nicht unbemerkt in den
# Quellcode. Gelesen wird alles, was uebernommen werden kann (versioniert UND neu, nicht ignoriert).
# Jeder Fund sperrt; ausgegeben wird er nur maskiert. Eng gefasste Formate — s. tools/geheimnis-scan.ts.
stufe geheimnis-scan; bash tools/geheimnis-scan.sh ||{ echo "✖ Geheimnis-Scan rot"; exit 1; }
stufe test
# Mit Argumenten (Dateifilter, `-t`) misst die Stufe nur einen Teil des Bestands — sichtbar machen.
if [ "$#" -gt 0 ]; then stufe_status auswahl "Argumente an tools/test: $*"; fi
./tools/test "$@"

# AUFTRAG-mega24 Block A: der UI-Smoke gehört INS TOR — seit Aufnahme 20260922 in DREI Engines
# (Chromium, Firefox, WebKit); bis dahin Chromium-only, s. „WARUM NUR CHROMIUM" unten.
#
# WARUM ÜBERHAUPT: bis mega23 war `smoke:ui` kein Teil dieses Gates, und die Automatisierung fuhr
# ihn damals nicht mit — `.github/workflows/ci.yml` rief `npm run build`, `lint`, `arch` und `test`
# einzeln auf. In jener Zeit hat NICHTS in der Automatisierung diese Suite ausgeführt. Ergebnis:
# sie war rund fünfzehn Runden lang rot, das Tor meldete durchgehend grün, und aufgefallen ist es
# erst am Ship-Tor. Gefunden wurden dabei ZWEI echte Defekte — die kollidierenden Zugangsdaten UND
# ein seit SCRUM-458 stale Kernfluss-Test, der gar nicht mehr lief. Ein Tor, das eine ganze
# Fehlerklasse (weiße Seite, totes Bündel, verschobener Kernfluss) baulich nicht sehen kann,
# schweigt genau dann, wenn es reden müsste.
#
# STAND HEUTE (JOB 1080 / D3, nachgemessen): Das ist erledigt. `ci.yml:44-45` fährt das Gesamttor
# als EINEN Schritt (`./tools/check`) und provisioniert davor Chromium — der `check`-Job führt
# diese Suite also mit. Der frühere Zustand ist dabei kein Gerücht, sondern in der Repohistorie
# belegt: Commit `57ef021a` (14.08.2026) trägt ein `ci.yml` mit SHA-256 `e509ee14…60d4`, das genau
# die Viererliste enthält und weder `./tools/check` noch eine Browser-Provisionierung kennt.
#
# WAS DAMIT NICHT BELEGT IST — die Grenze gehört an dieselbe Stelle wie die Behauptung: dass gerade
# diese Abweichung einen bestimmten roten CI-Lauf verursacht hat. Dafür bräuchte es ein Laufartefakt
# des damaligen Workflows, und das liegt hier nicht vor. Belegt ist die frühere Struktur, nicht die
# Ursache eines konkreten Fehllaufs. Gegen einen Rückfall wachen
# `tests/app/ci-check-contract.test.ts` und `tests/app/job1080-ci-workflow-abgleich.test.ts`.
#
# WARUM NUR CHROMIUM: gemessen in mega24 — Tor ohne Smoke 49 s, mit allen drei Engines 123 s (2,5×),
# mit Chromium allein rund 75 s (1,5×). Die drei Engines gibt es wegen browsernaher History-Mechanik
# (`history.go`, popstate-Reihenfolge); DIESE Fragen sind Sonden-Stoff, nicht Tor-Stoff. Die Klasse,
# die das Tor fangen muss — „lebt der Kernfluss überhaupt noch?" — ist engine-unabhängig und fällt
# schon in einer Engine auf. Der vollständige Drei-Engine-Lauf bleibt `npm run smoke:ui` und ist
# weiterhin Ship-Vorbedingung.
#
# AUFNAHME 20260922 (R-1334/R-1382/R-1916, A19) — DIE BEGRÜNDUNG OBEN IST ÜBERHOLT. „Ein einmaliger
# grüner Lauf ist keine Garantie. Bricht Safari beim Kunden, erfahren wir es vom Kunden." Genau der
# Drei-Engine-Lauf hat die unbedienbare Tastaturführung in Safari gefunden — ein Fehler, den das
# Chromium-only-Tor baulich nicht sehen konnte. Die Sperre aus Auflage 2 (K7 in
# `tests/smoke/job1094-engine-kette.test.ts`: erst nach grüner Stufe A verdrahten) ist erfüllt:
# Stufe A lief am 10.10.2026 auf dem regulären Prüfweg grün — Firefox 151.0 und WebKit 26.5 je
# gestartet, ohne Startfehler, je 14 bestanden / 4 übersprungen (Chromium-only-Fälle, sichtbar).
#
# WIE DAS TOR DIE DREI ENGINES FÄHRT — und warum NICHT als ein `smoke:ui:gate:drei` über alles:
#   · Chromium fährt wie bisher die VOLLE Suite (`smoke:ui:gate`).
#   · Firefox und WebKit fahren je in einem EIGENEN Lauf die Kern-Rauchproben (`ui-smoke`,
#     `smoke-umgebung`, `mobile-drawer-focus-probe`) — genau die Form, die Stufe A grün belegt hat.
#   Die volle Suite in allen drei Engines wurde am 10.10.2026 gemessen (Prüfbelege
#   `tor-deckung-firefox` / `tor-deckung-webkit`, Kandidat 8a8a7bd) und war in 14 Fällen aus zehn
#   Specs rot, neun davon fremde Feature-Specs (u. a. Browser-Zurück in Firefox, Fettdruck per
#   Kürzel, Vollbild, Fokusring in WebKit). Sie sind für Chromium gebaut und gehören den jeweiligen
#   Aufträgen; sie hier abzuschwächen oder zu überspringen wäre die falsche Antwort. Dazu kommt ein
#   Bestandsproblem:
#   ein Lauf über mehrere Projekte teilt EINEN In-Memory-Server, die Datenlage der späteren Engine
#   ist dann die der früheren (mega49 „Prüf-Board leer" war in der vollen Messung rot, in Stufe A grün).
#   Getrennte Läufe je Engine haben je einen frischen Server. Weitere Specs kommen in den Firefox-/
#   WebKit-Lauf, sobald sie dort grün belegt sind.
#
# Welche Engines ein Lauf WIRKLICH gestartet hat, druckt der Engine-Bericht am Laufende
# (`tests-smoke/support/engine-bericht.ts`); eine Engine, die nicht startet, macht den Lauf rot und
# steht dort als Startfehler — nie als „gefahren".
#
# Der geseedete UX-20b-Lauf weiter unten bleibt bewusst Chromium: er prüft den Inhaltszweig des
# JSON-Rundlaufs, nicht die Engine-Abdeckung, und mehrere seiner Fälle sind ausdrücklich nur in
# Chromium steuerbar (`NUR_CHROMIUM_TAB` in `tests-smoke/ui-smoke.spec.ts`).
#
# WARUM ZWEI TESTS FEHLEN (`--grep-invert @modell`): „Kernfluss" klickt „Mit KI strukturieren". Seit
# „KI-Ehrlichkeit" (AI-STATE V1-V5) ist dieser Knopf hart ausgegraut, solange kein echtes Modell
# aktiv ist (`apps/web/src/lib/aiAvailability.ts:29-49`) — richtiges Produktverhalten. Dieses Tor ist
# aber HERMETISCH: kein Schlüsselbund, kein Modell, kein Netz. Der Test kann hier also gar nicht grün
# werden, und ihn mitzunehmen hiesse, das Tor an ein Cloud-Geheimnis UND an echten Egress zu binden.
# Er bleibt dem vollen `npm run smoke:ui` vorbehalten.
#
# AUFTRAG-mega52 — DER ZWEITE FALL WAR IMMER SCHON DERSELBE FALL, nur unbemerkt. „Fragen antwortet
# ehrlich" hing an EXAKT derselben Sperre (der Fragen-Knopf ist ohne Modell hart ausgegraut) und
# konnte im Tor deshalb nie eine Antwort sehen — die Playwright-Spur des Tor-Laufs enthielt keinen
# einzigen `/api/ask`-Aufruf. Grün war er, weil `getByText` teilzeichenketten- und schreibweisen-
# unabhängig matcht und sich im STATISCHEN Einleitungstext der Seite selbst traf. Aufgefallen ist
# das erst, als mega52 diesen Text auf die Wahrheit zog. Was im Tor NACHWEISBAR ist, prüft jetzt
# „Fragen ohne Modell: der Weg ist gesperrt und sagt warum" — der läuft hier mit.
#
# AUFTRAG-mega25 — DIE ZWEI ZUSAGEN DIESES ABSCHNITTS SIND JETZT GEDECKT. Bis mega24 STANDEN sie
# hier nur, und beide waren ungedeckt (ben, sammel24):
#
#   „hermetisch": begründet war sie mit `tools/test:8`, das `KLARWERK_SKIP_KEYCHAIN=1` in einem
#   KINDPROZESS exportiert. Der Smoke unten läuft im ELTERNprozess, dessen Umgebung ein Kind nicht
#   ändern kann — ein gewöhnlicher `./tools/check`-Aufruf konnte den persönlichen Schlüsselbund also
#   weiterhin auflösen. Die Variable wird jetzt am TATSÄCHLICHEN Smoke-Server gesetzt
#   (`playwright.smoke.config.ts` → `webServer.env`, gewinnt gegen `process.env`), und sie wird nicht
#   geglaubt, sondern geprüft: `tests-smoke/smoke-umgebung.spec.ts` liest den Reasoner-Status des
#   laufenden Servers und wird ROT, wenn die Umgebung ihn nicht erreicht hat.
#
#   „genau einer": `--grep-invert @modell` ist ein TAG-Filter ohne Kardinalität — ein zweiter
#   @modell-Test wäre still mitausgeschlossen worden und die Meldung unten hätte weiter „genau
#   einer" behauptet. Den Mengen-Pin trägt jetzt `tests/smoke/tor-ausnahme.test.ts`; er läuft im
#   Schritt „test" oben, also VOR diesem Smoke, und macht jede Abweichung rot.
#
# NICHTS DAVON GESCHIEHT STILL — genau das war ja die Krankheit. Die Ausnahme wird unten
# ausgedruckt, sie ist auf EINEN benannten Test begrenzt, und fehlende Browser machen das Tor ROT
# mit Handlungsanweisung (kein „skip, wenn Chromium fehlt").
stufe ui-smoke-chromium "volle Suite — hermetisch, ohne @modell"
npm run --silent smoke:ui:gate || {
  echo "✖ UI-Smoke rot."
  echo "  Fehlt der Browser? → npx playwright install chromium"
  echo "  Alle drei Engines lokal: npm run smoke:ui (braucht KLARWERK_SHIP_SMOKE_API_KEY)"
  exit 1
}
# Bewusst ausgeschrieben statt als Schleife: die Kettenwächter lösen die Aufrufe statisch auf.
stufe ui-smoke-firefox "Kern-Rauchproben — hermetisch, ohne @modell"
npm run --silent smoke:ui:gate:kern:firefox || {
  echo "✖ UI-Smoke Firefox rot."
  echo "  Fehlt der Browser? → npx playwright install chromium firefox"
  echo "  Ob Firefox überhaupt startete, steht im Engine-Bericht oben (Startfehler)."
  exit 1
}
stufe ui-smoke-webkit "Kern-Rauchproben — hermetisch, ohne @modell"
npm run --silent smoke:ui:gate:kern:webkit || {
  echo "✖ UI-Smoke WebKit rot."
  echo "  Fehlt der Browser? → npx playwright install chromium webkit"
  echo "  Ob WebKit überhaupt startete, steht im Engine-Bericht oben (Startfehler)."
  exit 1
}
# UX-20b-R — DER GESEEDETE INHALTSZWEIG DES JSON-RUNDLAUFS, IM TOR UND NICHT NUR AUF ZURUF.
#
# Der Lauf oben ist ungeseedet: dort kehrt `UX-20b L3` nach der Formprüfung mit einer Anmerkung zurück
# (`ui-smoke.spec.ts`, „Lauf ohne KLARWERK_SMOKE_SEED"), und L3-T reicht nur die Mindestvorlage ein.
# Der Inhalt — Export gegen die Seed-Sollmenge, exakter Zähler, neu gelesene Kandidaten, Dublettenbefund
# und Urheberschaft — lief bisher nur mit `npm run smoke:ui:gate:daten` von Hand (Bens Befund,
# Runde 2). Deshalb hier ein ZWEITER Server mit Demo-Bestand, beschränkt auf die UX-20b-Fälle: den vollen
# geseedeten Lauf ins Tor zu nehmen hiesse, jede fremde Sonde auf eine Datenlage zu verpflichten, für
# die sie nicht gebaut ist. Das Setup-Projekt (Ersteinrichtung + „Demodaten laden") läuft als
# Abhängigkeit mit. Hermetisch wie oben: kein Modell, kein Zugangsdatum, kein Egress.
stufe ui-smoke-geseedet "Chromium, nur UX-20b: L1–L3, L3-T, G1–G4"
KLARWERK_SMOKE_MODE=gate KLARWERK_SMOKE_SEED=1 ANTHROPIC_API_KEY= ./tools/browserdeckel.sh smoke \
  npx playwright test --config playwright.smoke.config.ts --project=chromium --grep "UX-20b" || {
  echo "✖ Geseedeter UX-20b-Smoke rot (JSON-Rundlauf mit Inhalt)."
  echo "  Einzeln: npm run smoke:ui:gate:daten -- --grep \"UX-20b\""
  exit 1
}
# aufnahme:20260922:gesamt-prueftor-einheitlich — HIER STAND DIE AUSNAHMELISTE VON HAND: „alle
# vier", während tests/smoke/tor-ausnahme.test.ts längst acht Fälle führte. Die Liste druckt jetzt
# der Bericht der EXIT-Falle aus tests/smoke/tor-ausnahmen.json — derselben Datei, deren Menge der
# Pin gegen Playwright prüft —, zusammen mit den Wegen ausserhalb dieses Tors (CI-Job integration,
# Ship-Vorbedingung) und auch dann, wenn das Tor vorher rot endet. Dass der Tor-Lauf wirklich ohne
# Modell lief, hält tests-smoke/smoke-umgebung.spec.ts fest. „✓ check grün" druckt der Bericht erst,
# wenn alle Stufen des Vertrags gelaufen sind.
