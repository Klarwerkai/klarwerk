#!/usr/bin/env bash
# tools/check — Gesamtgate: Build + Lint + Architektur + Tests. Nur grün = lieferbar.
set -euo pipefail
cd "$(dirname "$0")/.."
# JOB 943 (Register I14): der cwd-Vertrag steht VOR allem anderen — er kostet Millisekunden und
# beantwortet die Frage, ob die folgenden Schritte überhaupt am richtigen Bestand arbeiten. Er ist
# fail-closed: eine markerlose oder gleichnamige falsche Wurzel bricht hier ab, statt sie zu raten.
echo "▶ cwd-vertrag";  node tools/check-cwd-contract.mjs || { echo "✖ cwd-Vertrag verletzt"; exit 1; }
echo "▶ build";        ./tools/build
echo "▶ lint";         ./tools/lint
echo "▶ architecture"; npx depcruise --config .dependency-cruiser.cjs services || { echo "✖ Architekturregeln verletzt"; exit 1; }
echo "▶ test";         ./tools/test "$@"

# AUFTRAG-mega24 Block A: der UI-Smoke gehört INS TOR — und zwar Chromium-only.
#
# WARUM ÜBERHAUPT: bis mega23 war `smoke:ui` kein Teil dieses Gates, und CI fährt ihn bis heute
# nicht (.github/workflows/ci.yml ruft build/lint/arch/test einzeln auf). Damit hat NICHTS in der
# Automatisierung diese Suite je ausgeführt. Ergebnis: sie war rund fünfzehn Runden lang rot, das
# Tor meldete durchgehend grün, und aufgefallen ist es erst am Ship-Tor. Gefunden wurden dabei ZWEI
# echte Defekte — die kollidierenden Zugangsdaten UND ein seit SCRUM-458 stale Kernfluss-Test, der
# gar nicht mehr lief. Ein Tor, das eine ganze Fehlerklasse (weiße Seite, totes Bündel, verschobener
# Kernfluss) baulich nicht sehen kann, schweigt genau dann, wenn es reden müsste.
#
# WARUM NUR CHROMIUM: gemessen in mega24 — Tor ohne Smoke 49 s, mit allen drei Engines 123 s (2,5×),
# mit Chromium allein rund 75 s (1,5×). Die drei Engines gibt es wegen browsernaher History-Mechanik
# (`history.go`, popstate-Reihenfolge); DIESE Fragen sind Sonden-Stoff, nicht Tor-Stoff. Die Klasse,
# die das Tor fangen muss — „lebt der Kernfluss überhaupt noch?" — ist engine-unabhängig und fällt
# schon in einer Engine auf. Der vollständige Drei-Engine-Lauf bleibt `npm run smoke:ui` und ist
# weiterhin Ship-Vorbedingung.
#
# WARUM ZWEI TESTS FEHLEN (`--grep-invert @modell`): „Kernfluss" klickt „Mit KI strukturieren". Seit
# „KI-Ehrlichkeit" (AI-STATE V1-V5) ist dieser Knopf hart ausgegraut, solange kein echtes Modell
# aktiv ist (`apps/web/src/lib/aiAvailability.ts:29-49`) — richtiges Produktverhalten. Dieses Tor ist
# aber HERMETISCH: kein Schlüsselbund, kein Modell, kein Netz. Der Test kann hier also gar nicht grün
# werden, und ihn mitzunehmen hiesse, das Tor an ein Cloud-Geheimnis UND an echten Egress zu binden.
# Er bleibt dem vollen `npm run smoke:ui` vorbehalten.
#
# AUFTRAG-mega52 — DER ZWEITE FALL WAR IMMER SCHON DERSELBE FALL, nur unbemerkt. „Fragen antwortet
# ehrlich" hing an EXAKT derselben Sperre (der Fragen-Knopf ist ohne Modell hart ausgegraut) und
# konnte im Tor deshalb nie eine Antwort sehen — die Playwright-Spur des Tor-Laufs enthielt keinen
# einzigen `/api/ask`-Aufruf. Grün war er, weil `getByText` teilzeichenketten- und schreibweisen-
# unabhängig matcht und sich im STATISCHEN Einleitungstext der Seite selbst traf. Aufgefallen ist
# das erst, als mega52 diesen Text auf die Wahrheit zog. Was im Tor NACHWEISBAR ist, prüft jetzt
# „Fragen ohne Modell: der Weg ist gesperrt und sagt warum" — der läuft hier mit.
#
# AUFTRAG-mega25 — DIE ZWEI ZUSAGEN DIESES ABSCHNITTS SIND JETZT GEDECKT. Bis mega24 STANDEN sie
# hier nur, und beide waren ungedeckt (ben, sammel24):
#
#   „hermetisch": begründet war sie mit `tools/test:8`, das `KLARWERK_SKIP_KEYCHAIN=1` in einem
#   KINDPROZESS exportiert. Der Smoke unten läuft im ELTERNprozess, dessen Umgebung ein Kind nicht
#   ändern kann — ein gewöhnlicher `./tools/check`-Aufruf konnte den persönlichen Schlüsselbund also
#   weiterhin auflösen. Die Variable wird jetzt am TATSÄCHLICHEN Smoke-Server gesetzt
#   (`playwright.smoke.config.ts` → `webServer.env`, gewinnt gegen `process.env`), und sie wird nicht
#   geglaubt, sondern geprüft: `tests-smoke/smoke-umgebung.spec.ts` liest den Reasoner-Status des
#   laufenden Servers und wird ROT, wenn die Umgebung ihn nicht erreicht hat.
#
#   „genau einer": `--grep-invert @modell` ist ein TAG-Filter ohne Kardinalität — ein zweiter
#   @modell-Test wäre still mitausgeschlossen worden und die Meldung unten hätte weiter „genau
#   einer" behauptet. Den Mengen-Pin trägt jetzt `tests/smoke/tor-ausnahme.test.ts`; er läuft im
#   Schritt „test" oben, also VOR diesem Smoke, und macht jede Abweichung rot.
#
# NICHTS DAVON GESCHIEHT STILL — genau das war ja die Krankheit. Die Ausnahme wird unten
# ausgedruckt, sie ist auf EINEN benannten Test begrenzt, und fehlende Browser machen das Tor ROT
# mit Handlungsanweisung (kein „skip, wenn Chromium fehlt").
echo "▶ ui-smoke (Chromium, hermetisch — ohne @modell)"
npm run --silent smoke:ui:gate || {
  echo "✖ UI-Smoke rot."
  echo "  Fehlt der Browser? → npx playwright install chromium"
  echo "  Alle drei Engines lokal: npm run smoke:ui (braucht KLARWERK_SHIP_SMOKE_API_KEY)"
  exit 1
}
echo "  ⓘ NICHT im Tor gelaufen: ui-smoke.spec.ts „Kernfluss … @modell\" und „Fragen antwortet"
echo "    ehrlich … @modell\" — beide brauchen ein aktives"
echo "    Modell (Zugangsdatum + Egress), das dieses hermetische Tor bewusst nicht hat."
echo "    Dass es bei GENAU DIESEN ZWEI bleibt, hält tests/smoke/tor-ausnahme.test.ts fest;"
echo "    dass der Tor-Lauf wirklich ohne Modell lief, hält tests-smoke/smoke-umgebung.spec.ts fest."
echo "    Abgedeckt durch die Ship-Vorbedingung: npm run smoke:ui (drei Engines, mit Modell)."
echo "✓ check grün"
