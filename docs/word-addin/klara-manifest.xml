<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="TaskPaneApp">
  <!-- WP-KLARA-1: Word-Taskpane-Add-in "Klara" (Sideload). Das Taskpane liegt AUF der App-Domain
       (public/word-addin/), daher same-origin API-Zugriff mit Session-Cookie. app.klarwerk.ai leitet
       serverseitig 301 auf klarwerk.ai um — beide Domains stehen deshalb in den AppDomains.
       WP-KLARA-1c (Pedis Sideload-Befund, Word Mac 16.111): Kommentare stehen bewusst NACH dem
       Root-Element-Start — ein Kommentar-Header VOR <OfficeApp> war vermutlich Mitursache, dass das
       Add-in im Sideload nicht erschien. Vor dem Kopieren in den wef-Ordner nichts umbauen. -->
  <Id>7f6b1c9e-4a2d-4e8f-9b3a-2c5d8e7f1a64</Id>
  <!-- klara1b (Pedis Live-Befund 24.07.): Version HOCHGEZAEHLT. Office cached das Manifest je
       Id+Version; blieb die Version bei 1.0.0.0, griff der ReadWriteDocument-Rechtewechsel im
       Sideload NICHT (alter Cache mit ReadDocument) → "insufficient permissions" beim Einfuegen.
       Ein Versions-Bump erzwingt beim Re-Sideload ein frisches Manifest mit ReadWriteDocument. -->
  <Version>1.0.0.1</Version>
  <ProviderName>KLARWERK</ProviderName>
  <DefaultLocale>de-DE</DefaultLocale>
  <DisplayName DefaultValue="Klara" />
  <Description DefaultValue="Klara verbindet Word mit KLARWERK: markierten Text als Wissens-Entwurf senden — ehrlich, ohne Automatik." />
  <IconUrl DefaultValue="https://app.klarwerk.ai/word-addin/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://app.klarwerk.ai/word-addin/icon-80.png" />
  <SupportUrl DefaultValue="https://app.klarwerk.ai/" />
  <AppDomains>
    <AppDomain>https://app.klarwerk.ai</AppDomain>
    <AppDomain>https://klarwerk.ai</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document" />
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="WordApi" MinVersion="1.1" />
    </Sets>
  </Requirements>
  <DefaultSettings>
    <!-- JOB 899 (OFFEN.md K7): DIE TASKPANE-URL TRAEGT DIE MANIFESTVERSION ALS CACHEKENNUNG.
         Ohne sie blieb ein ausgeliefertes Taskpane bei jedem Client im Cache, und es gab keinen Weg,
         ihn zu entwerten: aenderte sich nur die Seite und nicht das Manifest, hatte kein Client einen
         Anlass, sie neu zu holen. Der Versionssprung allein half nicht — er steuert den Cache des
         MANIFESTS, nicht den Inhalt des Taskpanes. Bei einem Kunden mit dreissig Arbeitsplaetzen
         kostete das dreissig Cache-Leerungen, und niemand weiss vorher, dass er sie braucht.
         DIE KENNUNG IST EXAKT <Version> — KEIN INHALTS-HASH, KEIN ZEITSTEMPEL. Ein Inhaltshash zoege
         die URL bei jeder Textaenderung mit und entwertete genau den BEWUSSTEN Versionsschritt, den
         diese Bindung erhalten will; ein Zeitstempel machte die URL bei identischem Inhalt
         verschieden. Ein Taskpane-Release VERLANGT damit einen Versionsschritt — das ist die Zusage.
         KEINE NEUE DOMAIN, KEIN LAUFZEIT-EGRESS: derselbe Host, derselbe Pfad, nur eine Query. Die
         Auslieferung ist davon unberuehrt — `services/app/src/web-static.ts` schneidet Query und
         Fragment vor dem Pfadvergleich ab, `/word-addin/*` trifft also weiterhin zu.
         WER DIE VERSION HIER HEBT, HEBT SIE AUCH OBEN. Beide Werte werden gemeinsam geprueft
         (`tests/app/word-addin-taskpane-cache.test.ts`, `tests/app/word-addin.test.ts`). -->
    <SourceLocation DefaultValue="https://app.klarwerk.ai/word-addin/taskpane.html?v=1.0.0.1" />
  </DefaultSettings>
  <!-- WP-KLARA-1b (K3, Least-Privilege): bis KLARA-2 las das Add-in nur die Selektion — ReadDocument.
       WP-KLARA-ASK (Teil 2, Pedis Entscheid 22.07.): "Antwort in Word einfuegen" ist eine bewusste
       Dokument-MUTATION (setSelectedDataAsync an der Cursorposition) — ReadWriteDocument ist jetzt die
       kleinste ausreichende Stufe (Office kennt keine feinere Schreib-Berechtigung fuers Taskpane). -->
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
