<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="TaskPaneApp">
  <!-- aufnahme:20260922:excel-erster-weg (KO-04-01): Klara als Seitenfenster in POWERPOINT (Mac, Web).
       Eigenes Manifest neben dem Word-Manifest (unverändert): eigene Id, eigene Version.
       Mindeststufe PowerPointApi 1.1. Folienliste (1.2), Text eines Textfelds schreiben (1.4) und
       Auswahl von Folien/Formen (1.5) prüft das Fenster zur LAUFZEIT; fehlt 1.5, liest es nur den
       markierten Text über die gemeinsame Office-API und schreibt nichts zurück. -->
  <Id>a84f1d2c-6b3e-4c7a-9e5d-1f0b8c2a7d46</Id>
  <!-- Dieselbe Zahl wie KLARA_OFFICE_TASKPANE_FASSUNG (services/app/src/web-static.ts) und wie die
       Kennung in SourceLocation unten; gemeinsam geprüft in tests/office-addin/manifeste.test.ts. -->
  <Version>1.0.0.1</Version>
  <ProviderName>KLARWERK</ProviderName>
  <DefaultLocale>de-DE</DefaultLocale>
  <DisplayName DefaultValue="Klara" />
  <Description DefaultValue="Klara in PowerPoint: Folie oder Textfeld lesen, Fragen dazu stellen und Text gezielt zurückgeben – nur nach Ihrer Bestätigung." />
  <IconUrl DefaultValue="https://app.klarwerk.ai/word-addin/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://app.klarwerk.ai/word-addin/icon-80.png" />
  <SupportUrl DefaultValue="https://app.klarwerk.ai/" />
  <AppDomains>
    <AppDomain>https://app.klarwerk.ai</AppDomain>
    <AppDomain>https://klarwerk.ai</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation" />
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="PowerPointApi" MinVersion="1.1" />
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://app.klarwerk.ai/office-addin/taskpane.html?v=1.0.0.1" />
  </DefaultSettings>
  <!-- Schreiben ist eine bewusste Rückgabe nach zweitem Klick (Text eines markierten Textfelds).
       Klara legt keine Formen, Bilder oder Figuren an. -->
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
