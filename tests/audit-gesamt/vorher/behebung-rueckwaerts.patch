-    fassung: ENTWURFS_INDEX_FASSUNG,
-    stand: draft.updatedAt,
-    inhaltsHash,
-    text: geschnitten ? roh.slice(0, MAX_SEARCH_TEXT_LENGTH) : roh,
-    status: geschnitten ? "unvollstaendig" : "vollstaendig",
