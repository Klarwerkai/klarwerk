-  en: {
-    kopf: "from the company glossary, not part of the source count",
-    eintrag: "glossary entry",
-    fassung: "version",
-    verantwortlich: "responsible",
-  },
-  nl: {
-    kopf: "uit het bedrijfswoordenboek, geen deel van de bronnentelling",
