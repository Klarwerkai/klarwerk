-        `routine.abschnitte: erlaubt sind ${ROUTINE_ABSCHNITTE.join(", ")}.`,
-      );
-    }
-    if (!abschnitte.includes(a)) {
-      abschnitte.push(a);
-    }
-  }
-  const notizRoh = r.notizIds ?? [];
