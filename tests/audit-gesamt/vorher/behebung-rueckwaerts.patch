-export class KlaraGespraechAusgabe {
-  constructor(private readonly d: AusgabeDeps) {}
-
-  /** Derselbe eigene, unveränderte Beleg für Gespräch, Notiz und Gedächtnis. */
-  async antwortQuellen(
-    kontoId: string,
-    antwortId: string | null,
