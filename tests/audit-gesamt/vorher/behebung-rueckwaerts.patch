-function kennungen(wert: unknown, max: number, feld: string): string[] {
-  if (wert === undefined || wert === null) return [];
-  if (
-    !Array.isArray(wert) ||
-    wert.length > max ||
-    wert.some((x) => typeof x !== "string" || x.length === 0 || x.length > 200)
-  ) {
-    throw eingabe(`${feld}: höchstens ${max} Kennungen.`);
