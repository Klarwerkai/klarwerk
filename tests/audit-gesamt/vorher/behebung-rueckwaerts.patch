-function schutzBefund(kandidat: ImportCandidate): SchutzBefund {
-  const item = kandidat.item;
-  const texte = [
-    item.title,
-    item.statement,
-    typeof item.bodyHtml === "string" ? htmlToPlainText(item.bodyHtml) : undefined,
