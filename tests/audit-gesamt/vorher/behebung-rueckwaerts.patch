-  /** Prüft und kanonisiert einen eingereichten Stand (Titel getrimmt, Rumpf sanitisiert). */
-  private pruefeStand(eingabe: EntwurfsStand): EntwurfsStand {
-    const stand: EntwurfsStand = {
