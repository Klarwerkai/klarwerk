-function steuerNach(e: KlaraErinnerung, bearbeitetBis: number | null): KlaraErinnerungSteuer {
-  return {
-    bearbeitetBis,
-    naechste: e.status === "aktiv" ? naechsteFaelligkeit(e, bearbeitetBis) : null,
-  };
-}
