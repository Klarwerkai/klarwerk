-    const b = e.bezug;
-    try {
-      if (b.art === "notiz" && this.deps.notizen) {
-        const n = await this.deps.notizen.hole(e.kontoId, b.notizId);
-        return n
-          ? {
-              text: `${n.titel}\n\n${n.inhalt}`,
