-    this.pruefeHaltbarkeit();
-    const belegt = [...this.versuche.values()].some(
-      (v) =>
-        v.fragensatzId === versuch.fragensatzId &&
-        v.fragensatzVersion === versuch.fragensatzVersion &&
-        v.personId === versuch.personId &&
-        v.nummer === versuch.nummer,
