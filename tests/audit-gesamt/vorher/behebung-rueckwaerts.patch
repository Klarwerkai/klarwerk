-/** Ein Ordner- oder Dateiname, der auf jedem System geöffnet werden kann. */
-export function sichererName(roh: string, ersatz: string): string {
-  const name = roh
-    .normalize("NFKD")
-    .replace(/\p{M}/gu, "")
-    .replace(/ß/g, "ss")
-    .replace(/[^A-Za-z0-9._-]+/g, "-")
-    .replace(/-+/g, "-")
-    .replace(/^[-.]+|[-.]+$/g, "")
-    .slice(0, 60);
-  return name.length > 0 ? name : ersatz;
-}
