-export type KlaraErinnerungGrund =
-  | "eingabe"
-  | "unbekannt"
-  | "quelle_unbekannt"
-  | "vorgang_belegt"
-  | "voll"
-  | "konflikt"
-  | "vergangen"
-  | "zustand"
-  | "klaerung"
