-  private async mitFassung(
-    kontoId: string,
-    id: string,
-    fassung: unknown,
-  ): Promise<KlaraErinnerungEintrag> {
-    const f = this.fassungAus(fassung);
-    const alt = await this.eintrag(kontoId, id);
-    if (alt.erinnerung.fassung !== f) {
-      throw this.konflikt();
-    }
-    return alt;
-  }
