-function zuordnungSicht(z: KalenderZuordnung): Omit<KalenderZuordnung, "kontoId"> {
-  return Object.fromEntries(Object.entries(z).filter(([k]) => k !== "kontoId")) as Omit<
-    KalenderZuordnung,
-    "kontoId"
-  >;
