-  for (const eintrag of liste) {
-    const g =
-      typeof eintrag === "object" && eintrag !== null
-        ? text((eintrag as { value?: unknown }).value)
-        : text(eintrag);
-    if (g && !gruppen.includes(g)) {
-      gruppen.push(g);
-    }
-  }
-  return gruppen;
-}
