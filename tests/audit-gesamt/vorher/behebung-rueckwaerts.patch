-  private mitAntwort(
-    e: KiAuftragEintrag,
-    jetzt: string,
-    a: {
-      readonly inhalt: string;
-      readonly anbieter: string;
-      readonly modell: string | null;
-      readonly weg: "api" | "manuell";
-      readonly aktuell: Pick<KiArbeitsbereich, "dokumentId" | "dokumentFassung">;
-      readonly beleg: KiBelegEintrag;
