-    url = new URL(roh);
-  } catch {
-    return undefined;
-  }
-  if (url.username !== "" || url.password !== "") {
-    return undefined;
-  }
-  if (url.protocol === "https:") {
-    return url.toString();
-  }
-  if (url.protocol === "http:" && EIGENE_MASCHINE.has(url.hostname)) {
-    return url.toString();
-  }
-  return undefined;
