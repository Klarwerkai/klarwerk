-  if (auftrag.quellen.some((id) => !quellKennungen.has(id))) {
-    throw new ZusammenfuehrungsFehler(
-      "INVALID",
-      "quellen: nur Quellen des aufgehenden Artikels können mitgenommen werden.",
-    );
-  }
