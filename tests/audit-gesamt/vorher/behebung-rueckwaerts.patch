-          art,
-          quelle: kennung,
-          lage,
-          erfassteFassung: erfasst,
-          aktuelleFassung: aktuell,
-          // Die betroffene Wissensfassung — welche Fassung des Objekts aus dieser Quelle stammt.
-          ...(wissensfassung !== undefined ? { wissensfassung } : {}),
-        },
-      });
