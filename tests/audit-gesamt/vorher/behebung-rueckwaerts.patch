-  const l = lokalVon(v.ms, zone);
-  return {
-    vorkommenId: v.id,
-    schluessel: v.schluessel,
-    zeitpunkt: new Date(v.ms).toISOString(),
-    datum: l.datum,
-    uhrzeit: l.uhrzeit,
