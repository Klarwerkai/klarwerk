-        // Die Marke geht NUR an die eigene Seite, die sie per Formular-POST in das iframe gibt.
-        reply.header("Cache-Control", "no-store");
-        reply.code(200).send({
-          editorUrl: adresse,
-          editorHerkunft: umgebung.editorHerkunft,
-          accessToken: marke,
