-
-function maschinell(
-  dimension: Dimension,
-  grund: string,
-  weg: string,
-  inhalt: Inhalt,
-  fassung: number,
-  h: Handelnder,
-): Pruefung {
-  return {
-    id: h.kennung(),
-    dimension,
-    ergebnis: "bestanden",
-    grund,
-    von: `klarwerk:${weg}`,
-    am: h.jetzt,
-    datenFassung: fassung,
-    fingerabdruck: fingerabdruck(inhalt),
-  };
