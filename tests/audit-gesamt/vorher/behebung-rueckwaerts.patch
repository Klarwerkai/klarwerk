-  if (jahr && !d.zeitraum?.includes(jahr)) return false;
-  const einheiten = [
-    ...frage.matchAll(/[-−+]?\d+(?:[.,]\d+)*\s*(T€|Mio\.?\s*€|EUR|Euro|€|%|USD|\$)/giu),
-  ];
-  const norm = (s: string) =>
-    s
-      .toLowerCase()
-      .replace(/\s|\./gu, "")
-      .replace(/euro|eur/gu, "€");
-  for (const m of einheiten) {
-    if (zahlAusWert(m[0]) !== d.zahl) continue;
