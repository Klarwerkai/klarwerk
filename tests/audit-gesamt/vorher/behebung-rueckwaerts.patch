-      fehler.push(
-        `Eintrag ${i + 1} (${id}): max und fensterSek müssen positive ganze Zahlen sein.`,
-      );
-      continue;
-    }
-    vergebeneIds.add(id);
-    for (const s of summen) {
-      vergebeneSummen.add(s);
-    }
