-function wiederholbar(e: Faehigkeitsergebnis): boolean {
-  return (
-    e.wirkungKennung === null &&
-    (e.stand === "fehlgeschlagen" || e.stand === "gesperrt" || e.stand === "voraussetzung_fehlt")
