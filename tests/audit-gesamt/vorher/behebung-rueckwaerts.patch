-        const e = (t ?? {}) as { tabelle?: unknown; dump?: unknown; datenbank?: unknown };
-        return typeof e.tabelle === "string"
-          ? [
-              {
-                tabelle: e.tabelle.slice(0, 64),
-                dump: zahlOderNull(e.dump),
-                datenbank: zahlOderNull(e.datenbank),
-              },
