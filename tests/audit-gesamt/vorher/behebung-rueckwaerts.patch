-      nachrichten: [],
-      letzterSchritt: null,
-      einwilligungAm: null,
-      angelegtAm: jetzt,
-      geaendertAm: jetzt,
-      fassung: 1,
-    };
-    if (await this.repo.legeEinmal(g, bedingung)) return g;
-    const gefunden = await this.repo.hole(kontoId, id);
-    if (gefunden) return gefunden;
-    throw new KlaraGespraechFehler(
-      409,
-      "herkunft_gesperrt",
