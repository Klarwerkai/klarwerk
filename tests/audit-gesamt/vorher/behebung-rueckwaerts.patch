-/** Enger Adapter am bestehenden G-Journal. Ohne echten D-Guard und Schreibbedingung keine Wirkung. */
-export function dNormAuftragsPort(deps: KlaraDNormAuftragsDeps): KlaraDNormAuftragsPort {
