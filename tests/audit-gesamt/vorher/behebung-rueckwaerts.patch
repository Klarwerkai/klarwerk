-CREATE INDEX IF NOT EXISTS idx_verstaendnis_versuche_person ON verstaendnis_versuche(person_id);
-CREATE INDEX IF NOT EXISTS idx_verstaendnis_versuche_satz ON verstaendnis_versuche(fragensatz_id);
