-        status: "FAILED",
-        completedAt: new Date().toISOString(),
-        failureCode: ausgang.error,
-        failureReason: sanitizeImportFailureReason(message),
-      },
-      log,
-    );
-    return { code: ausgang.status, body: { error: ausgang.error, message } };
-  }
-}
