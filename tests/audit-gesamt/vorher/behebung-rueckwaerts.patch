-/** Die neue Fassung des Führungsartikels — ausschliesslich aus den Werten beider Seiten. */
-function neueFassung(
-  fuehrend: KnowledgeObject,
-  aufgehend: KnowledgeObject,
-  auftrag: ZusammenfuehrungsAuftrag,
-): {
-  title: string;
