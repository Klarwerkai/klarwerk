-// GEMEINSAME DIENSTE — einmal, für jedes Programm gleich
-// ------------------------------------------------------------------------------------------------
-
-export const GEMEINSAME_DIENSTE = {
-  anmeldung: "Bestehende KLARWERK-Sitzung (requireUser); im Word-Add-in die vorhandene Anmeldung.",
