-          continue;
-        }
-        for (const durch of geeignet) {
-          const art = await this.deps.validation.vertretungZuweisen(
-            ko.id,
-            durch,
-            a.userId,
-            user.id,
-          );
-          if (art === "bestehend") {
-            bestehend += 1;
-          } else {
-            neu.push({ koId: ko.id, durch, fuer: a.userId, art });
