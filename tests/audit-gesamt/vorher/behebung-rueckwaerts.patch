+  { name: "DELETE FROM", muster: /\bDELETE\s+FROM\b/i, klasse: "IRREVERSIBEL" },
+  { name: "DROP INDEX", muster: /\bDROP\s+INDEX\b/i, klasse: "TRANSFORMIEREND" },
