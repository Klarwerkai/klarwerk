-export function base32Kodieren(daten: Buffer): string {
-  let bits = 0;
-  let wert = 0;
-  let aus = "";
-  for (const byte of daten) {
-    wert = (wert << 8) | byte;
-    bits += 8;
-    while (bits >= 5) {
-      aus += BASE32.charAt((wert >>> (bits - 5)) & 31);
-      bits -= 5;
-    }
