-export function jiraZeitpunkt(roh: string | undefined): string | undefined {
-  const wert = roh?.trim().replace(/([+-]\d{2})(\d{2})$/, "$1:$2");
-  if (!wert) {
-    return undefined;
-  }
-  const ms = Date.parse(wert);
-  return Number.isFinite(ms) && ms > 0 ? new Date(ms).toISOString() : undefined;
-}
