-  if (lage.letzteSequenz === undefined || lage.letzteSequenz !== marke.seq) {
-    return nein("auswahl_veraltet");
-  }
-  if (lage.zielPruefsumme !== marke.sum) {
-    return nein("ziel_abweichend");
-  }
-  return { gueltig: true };
-}
