-// Der Laufkopf: woran ein Lauf gebunden ist. Ein erneutes Planen muss GENAU diese Aussagemenge mit
-// diesen Ständen und diesem Kontext nennen — sonst ist es ein anderer Lauf.
-export interface PaarpflichtLauf {
-  laufId: string;
