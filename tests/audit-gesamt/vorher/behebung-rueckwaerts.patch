-// R-0091: das Lücken-Interview — drei Fragen, ein Entwurf. Das Thema steht fest; gefragt wird nur
-// nach dem, was ein prüfbarer Entwurf mindestens braucht.
-const GAP_TREE: readonly TreeNode[] = [KERN, BEDINGUNG, MASSNAHME];
