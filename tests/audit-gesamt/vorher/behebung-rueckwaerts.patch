-function ohneInhalt(
-  zustand: "beschaedigt" | "geloescht" | "nicht_zugaenglich",
-  koId: string,
-): FundstellenAufloesung {
-  return { zustand, hinweis: FUNDSTELLEN_HINWEIS[zustand], koId };
