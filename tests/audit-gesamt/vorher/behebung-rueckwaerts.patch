-    const treffer: {
-      art: "entwurf" | "wissensobjekt";
-      id: string;
-      titel: string;
-      fassung?: number;
-      erfassteFassung: string | null;
-      aktuelleFassung: string | null;
-      lage: string;
-    }[] = [];
-
-    for (const { draft } of await capture.listDraftsForResume(user.id)) {
