-const FOLGE: Readonly<Record<string, Folgeaktion>> = {
-  konto_gewechselt: "verwerfen",
-  sitzung_gewechselt: "verwerfen",
-  instanz_gewechselt: "verwerfen",
-  dokument_gewechselt: "verwerfen",
