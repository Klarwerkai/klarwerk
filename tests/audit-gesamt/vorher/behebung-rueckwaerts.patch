-  /** Startet eine Operation (Lauf, Fortsetzen, Rücknahme), solange keine läuft. */
-  private betreibe(lauf: Lauf, f: () => Promise<unknown>): void {
-    if (lauf.operation) return;
-    const op = (async () => {
-      try {
-        await f();
-      } finally {
-        lauf.operation = null;
-        await this.schreibe(lauf);
-        lauf.relais.melde();
-      }
-    })();
-    lauf.operation = op;
-    op.catch(() => {});
