-          });
-          return;
-        }
-        try {
-          reply.code(200).send(await d.dienst.fristlauf(space, user, (ko) => darfSehen(user, ko)));
-        } catch (e) {
-          fehler(reply, e);
-        }
-      },
-    );
-  };
-}
