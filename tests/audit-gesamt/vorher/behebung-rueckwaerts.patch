-export function jiraLeserechte(
-  rollen: JiraRollenbesetzung | undefined,
-): KoSourceRestrictions | undefined {
-  if (!rollen || (rollen.users.length === 0 && rollen.groups.length === 0)) {
-    return undefined;
-  }
-  return { users: [...rollen.users], groups: [...rollen.groups] };
