-  }
-  get projectKey(): string {
-    return this.config.projectKey;
-  }
-
-  /**
-   * Ist `weiter` ein Cursor, den DIESER Client deuten kann? Cloud: ein nicht leeres Token ohne
-   * Leer- und Steuerzeichen. Data Center: eine Startposition (Ziffern).
-   */
