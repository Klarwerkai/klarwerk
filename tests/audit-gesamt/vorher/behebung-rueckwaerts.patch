-    if (this.deps.kommunikation && vermerk.meldung !== "still") {
-      await this.deps.kommunikation.versenden({
-        id: vermerk.id,
-        koId: ko.id,
-        fassung: vermerk.fassung,
-        hervorgehoben: vermerk.meldung === "hervorgehoben",
