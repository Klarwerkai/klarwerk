-export function pruefeHandlungsbezug(lage: {
-  readonly marke: KontextmarkenInhalt;
-  readonly bindung: {
-    readonly sessionId: string;
-    readonly actorId: string;
-    readonly addinInstanceId: string;
-    readonly documentContextId: string;
