-      id: null,
-      titel: e.titel,
-      stand: null,
-      pfad: null,
-    };
-    return {
-      quelle: "d_routine",
-      wortlaut: `Gespeicherte ausdrückliche D-Bestellung: persönliche Prüfung zum Normereignis ${e.ereignisId}.`,
-      ziel: e.titel,
-      erlaubteAktionen: ["persoenliche_aufgabe_anlegen"],
-      erlaubteZiele: [ziel],
-      erlaubteQuellen: [`notiz:${e.notiz.id}`],
-      ergebnis:
