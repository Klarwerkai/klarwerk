-type QuellFeld =
-  | "title"
-  | "statement"
-  | "version"
-  | "confidentiality"
-  | "confidentialityProvenance"
-  | "quellrechte"
-  | "spaceId";
-type QuellDaten = Partial<Record<QuellFeld, unknown>>;
