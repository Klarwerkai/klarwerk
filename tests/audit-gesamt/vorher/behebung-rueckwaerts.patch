-// ------------------------------------------------------------------------------------------------
-// ÜBERLAGERUNG — die Befunde über dem PP-02-Prüfstand
-// ------------------------------------------------------------------------------------------------
-
-export interface KontrollDimension {
-  readonly dimension: Dimension;
-  readonly name: string;
-  readonly stand: DimensionsStand;
-  readonly standName: string;
-  readonly grund: string;
-  /** Woher der Stand kommt: eine Prüfung (Person/Weg, Zeit), eine Kontrolle oder noch nichts. */
-  readonly herkunft: "pruefung" | "kontrolle" | "keine";
-  readonly pruefung?: KontrollPruefung;
-  readonly befunde: readonly Kontrollbefund[];
-  /** Die konkrete Arbeit, die diesen Stand ändert (leer bei „bestanden“ und „trifft nicht zu“). */
-  readonly arbeit: readonly string[];
-}
-
-export interface Datenkontrolle {
-  readonly datenpunktId: string;
-  readonly datenFassung: number;
-  readonly zustand: Zustand;
-  readonly zustandName: string;
-  readonly grund: string;
-  readonly naechsteArbeit: readonly string[];
-  readonly erforderlich: readonly Dimension[];
-  readonly dimensionen: readonly KontrollDimension[];
-  readonly befunde: readonly Kontrollbefund[];
-  readonly prognose: boolean;
-  readonly gepruefAm: string;
-}
-
-/**
- * Legt die Befunde über den PP-02-Prüfstand (Regeln im Kopf der Datei) und leitet den Zustand neu
- * ab — mit denselben Stufen wie PP-02. „Validiert“ heißt weiterhin: ALLE erforderlichen Dimensionen
- * bestanden, die fachliche Freigabe eingeschlossen.
- */
-export function mitKontrollen(
-  dp: Pick<KontrollDatenpunkt, "id">,
-  stand: PruefstandEingang,
-  befunde: readonly Kontrollbefund[],
-  jetzt: number,
-): Datenkontrolle {
-  const erforderlich = new Set(stand.erforderlich);
-  // Die konkrete PP-02-Arbeit je überholter Dimension („Neu berechnen …“, „… an ihrer aktuellen
-  // Herkunft aktualisieren …“): PP-02 nennt sie zuerst, in der Reihenfolge der Dimensionen. Ohne sie
-  // wäre „… erneut prüfen“ eine wirkungslose Arbeit (unabhängige Prüfung, Befunde B1/B2).
-  const pp02Ueberholt = stand.dimensionen.filter((d) => d.stand === "ueberholt");
-  const pp02Arbeit = new Map<Dimension, string>();
-  if (stand.naechsteArbeit && stand.naechsteArbeit.length >= pp02Ueberholt.length) {
-    pp02Ueberholt.forEach((d, i) => {
-      const a = stand.naechsteArbeit?.[i];
-      if (a) {
-        pp02Arbeit.set(d.dimension, a);
-      }
-    });
-  }
-  const befundArbeit = (liste: readonly Kontrollbefund[]) =>
-    liste.flatMap((b) => (b.naechsteArbeit ? [b.naechsteArbeit] : []));
-  const dimensionen = DIMENSIONEN.map((dimension): KontrollDimension => {
-    const ein: DimensionsEingang = stand.dimensionen.find((d) => d.dimension === dimension) ?? {
-      dimension,
-      stand: "offen",
-      grund: "",
-    };
-    const eigene = befunde.filter((b) => b.dimension === dimension);
-    const klaerung = eigene.filter((b) => b.ergebnis === "klaerung");
-    const ersetzt = eigene.filter((b) => b.ergebnis === "bestanden" && b.ersetztPruefung);
-    const offeneBefunde = eigene.filter((b) => b.ergebnis === "offen");
-    let s: DimensionsStand = ein.stand;
-    let grund = ein.grund;
-    let herkunft: KontrollDimension["herkunft"] = ein.pruefung ? "pruefung" : "keine";
-    if (ein.stand === "ueberholt") {
-      // Regel 1: eine Änderung hebt den alten Status immer auf.
-    } else if (klaerung.length > 0) {
-      // Regel 2: ein konkreter Mangel lässt sich nicht wegbestätigen.
-      s = "klaerung";
-      grund = klaerung.map((b) => b.grund).join(" ");
-      herkunft = "kontrolle";
-      erforderlich.add(dimension);
-    } else if (ersetzt.length > 0 && (ein.stand === "offen" || ein.stand === "nicht_zutreffend")) {
-      // Regel 3: die Maschine beantwortet die Frage vollständig.
-      s = "bestanden";
-      grund = ersetzt.map((b) => b.grund).join(" ");
-      herkunft = "kontrolle";
-      erforderlich.add(dimension);
-    } else if (offeneBefunde.length > 0 && ein.stand === "nicht_zutreffend") {
-      // Eine Kontrolle macht die Dimension erforderlich (z. B. eine Summe, die an der aktuellen
-      // Fassung erst noch nachzurechnen ist) — sie bleibt offen, bis die Arbeit getan ist.
-      s = "offen";
-      grund = offeneBefunde.map((b) => b.grund).join(" ");
-      herkunft = "kontrolle";
-      erforderlich.add(dimension);
-    } else if (ein.stand === "bestanden" && offeneBefunde.some((b) => !gedeckt(b, ein.pruefung))) {
-      // Regel 5: ein neuer offener Befund, den die bestandene Prüfung nicht abdeckt (z. B. eine
-      // später erfasste, unsicher erkannte Gegenangabe), öffnet die Dimension wieder. Die frühere
-      // Prüfung bleibt sichtbar; gedeckte Befunde lassen sie gelten.
-      s = "offen";
-      grund = offeneBefunde
-        .filter((b) => !gedeckt(b, ein.pruefung))
-        .map((b) => b.grund)
-        .join(" ");
-      herkunft = "kontrolle";
-      erforderlich.add(dimension);
-    }
-    const name = DIMENSIONSNAME[dimension];
-    let arbeit: string[] = [];
-    if (s === "ueberholt") {
-      // Überholt: die konkrete PP-02-Arbeit (sonst „… erneut prüfen“) UND die Behebung konkreter
-      // Mängel dieser Dimension (Befund B4: beides nennen, nichts versprechen).
-      arbeit = [
-        pp02Arbeit.get(dimension) ?? `${name} für Fassung ${stand.datenFassung} erneut prüfen.`,
-        ...befundArbeit(klaerung),
-      ];
-    } else if (s === "klaerung" || s === "offen") {
-      const a = befundArbeit(
-        eigene.filter((b) => b.ergebnis === "klaerung" || b.ergebnis === "offen"),
-      );
-      arbeit =
-        a.length > 0 ? a : [s === "klaerung" ? `Klärung zu ${name}: ${grund}` : `${name} prüfen.`];
-    }
-    return {
-      dimension,
-      name,
-      stand: s,
-      standName: STANDNAME[s],
-      grund,
-      herkunft,
-      ...(ein.pruefung ? { pruefung: ein.pruefung } : {}),
-      befunde: eigene,
-      arbeit: [...new Set(arbeit)],
-    };
-  });
-  const relevant = dimensionen.filter((d) => d.stand !== "nicht_zutreffend");
-  const mit = (st: DimensionsStand) => relevant.filter((d) => d.stand === st);
-  const ueberholt = mit("ueberholt");
-  const klaerung = mit("klaerung");
-  const offen = mit("offen");
-  const bestanden = mit("bestanden");
-  const namen = (liste: readonly KontrollDimension[]) => liste.map((d) => d.name).join(", ");
-  let zustand: Zustand;
-  let grund: string;
-  if (ueberholt.length > 0) {
-    zustand = "ueberpruefung_noetig";
-    grund = `Überprüfung nötig (${namen(ueberholt)}): ${ueberholt.map((d) => d.grund).join(" ")}`;
-  } else if (klaerung.length > 0) {
-    zustand = "klaerung";
-    grund = `Klärungsbedarf (${namen(klaerung)}): ${klaerung.map((d) => d.grund).join(" ")}`;
-  } else if (offen.length === 0) {
-    zustand = "validiert";
-    grund = `Validiert für Datenfassung ${stand.datenFassung} im Prüfrahmen ${namen(relevant)}.${stand.prognose ? " Es bleibt eine Prognose mit Annahmen, kein beobachteter Wert." : ""}`;
-  } else if (bestanden.length > 0) {
-    zustand = "in_pruefung";
-    grund = `In Prüfung: bestanden ${namen(bestanden)}; offen ${namen(offen)}.`;
-  } else {
-    zustand = "erfasst";
-    grund = `Erfasst, noch nicht geprüft. Offen: ${namen(offen)}.`;
-  }
-  const naechsteArbeit = [...ueberholt, ...klaerung, ...offen].flatMap((d) => d.arbeit);
-  return {
-    datenpunktId: dp.id,
-    datenFassung: stand.datenFassung,
-    zustand,
-    zustandName: ZUSTANDSNAME[zustand],
-    grund,
-    naechsteArbeit: [...new Set(naechsteArbeit)],
-    erforderlich: DIMENSIONEN.filter((d) => erforderlich.has(d)),
-    dimensionen,
-    befunde,
-    prognose: stand.prognose,
-    gepruefAm: new Date(jetzt).toISOString(),
-  };
-}
-
-/** Kontrollen ausführen und über den PP-02-Prüfstand legen — der Einstieg für Route und Sicht. */
-export async function datenkontrolle(
-  dp: KontrollDatenpunkt,
-  stand: PruefstandEingang,
-  u: KontrollUmgebung,
-  bindungen: readonly BindungsEingang[] = [],
-): Promise<Datenkontrolle> {
-  return mitKontrollen(dp, stand, await kontrollen(dp, stand, u, bindungen), u.jetzt);
-}
-
-// ------------------------------------------------------------------------------------------------
-// DATENLAGE EINER PRÄSENTATION — erforderliche Prüfungen und offene Punkte auf einen Blick
-// ------------------------------------------------------------------------------------------------
-
-/** Eine noch zu erledigende Arbeit an einem Datenpunkt — Einstieg zu seinen Prüfdetails. */
-export interface OffenerPunkt {
-  readonly datenpunktId: string;
-  readonly zustand: Zustand;
-  readonly dimension: Dimension;
-  readonly stand: "klaerung" | "offen" | "ueberholt";
-  readonly titel: string;
-  readonly grund: string;
-  readonly naechsteArbeit: string;
-  /**
-   * Eine früher bestandene Prüfung, die eine Kontrolle wieder geöffnet hat (Regel 5). Sie bleibt in
-   * der Datenlage auch unter „nur Klärungen einzeln“ (Setup › Klara) einzeln sichtbar.
-   */
-  readonly wiedergeoeffnet?: true;
-}
-
-export interface Datenlage {
-  readonly anzahl: number;
-  readonly jeZustand: Readonly<Record<Zustand, number>>;
-  /**
-   * Je Datenpunkt jede erforderliche Dimension, die nicht bestanden ist (Klärung, offen, überholt),
-   * mit Grund und nächster Arbeit. Dieselbe Arbeit an demselben Datenpunkt erscheint einmal.
-   */
-  readonly offenePunkte: readonly OffenerPunkt[];
-}
-
-/** Die offenen Punkte einer Datenkontrolle — dieselben Arbeiten wie `naechsteArbeit`. */
-function offenePunkteVon(k: Datenkontrolle): OffenerPunkt[] {
-  const punkte: OffenerPunkt[] = [];
-  for (const d of k.dimensionen) {
-    if (d.stand !== "klaerung" && d.stand !== "offen" && d.stand !== "ueberholt") {
-      continue;
-    }
-    const kopf = { datenpunktId: k.datenpunktId, zustand: k.zustand, dimension: d.dimension };
-    if (d.stand === "ueberholt") {
-      punkte.push({
-        ...kopf,
-        stand: d.stand,
-        titel: `${d.name} überholt`,
-        grund: d.grund,
-        naechsteArbeit:
-          d.arbeit.join(" ") || `${d.name} für Fassung ${k.datenFassung} erneut prüfen.`,
-      });
-      continue;
-    }
-    const wieder =
-      d.stand === "offen" && d.pruefung !== undefined && d.herkunft === "kontrolle"
-        ? { wiedergeoeffnet: true as const }
-        : {};
-    const befunde = d.befunde.filter((b) => b.ergebnis === d.stand);
-    if (befunde.length === 0) {
-      punkte.push({
-        ...kopf,
-        stand: d.stand,
-        titel: d.stand === "klaerung" ? `Klärung zu ${d.name}` : `${d.name} offen`,
-        grund: d.grund,
-        naechsteArbeit:
-          d.stand === "klaerung" ? `Klärung zu ${d.name}: ${d.grund}` : `${d.name} prüfen.`,
-        ...wieder,
-      });
-      continue;
-    }
-    for (const b of befunde) {
-      punkte.push({
-        ...kopf,
-        stand: d.stand,
-        titel: b.titel,
-        grund: b.grund,
-        naechsteArbeit: b.naechsteArbeit ?? `${d.name} prüfen.`,
-        ...wieder,
-      });
-    }
-  }
-  // Dieselbe Arbeit an demselben Datenpunkt einmal — mit allen Anlässen.
-  const zusammen = new Map<string, OffenerPunkt>();
-  for (const p of punkte) {
-    const schluessel = `${p.datenpunktId}\u0000${p.naechsteArbeit}`;
-    const da = zusammen.get(schluessel);
-    zusammen.set(
-      schluessel,
-      da
-        ? {
-            ...da,
-            titel: `${da.titel} · ${p.titel}`,
-            grund: `${da.grund} ${p.grund}`,
-            ...(da.wiedergeoeffnet || p.wiedergeoeffnet ? { wiedergeoeffnet: true as const } : {}),
-          }
-        : p,
-    );
-  }
-  return [...zusammen.values()];
-}
-
-export function datenlage(liste: readonly Datenkontrolle[]): Datenlage {
-  const jeZustand: Record<Zustand, number> = {
-    erfasst: 0,
-    in_pruefung: 0,
-    klaerung: 0,
-    validiert: 0,
-    ueberpruefung_noetig: 0,
-  };
-  const offenePunkte: OffenerPunkt[] = [];
-  for (const k of liste) {
-    jeZustand[k.zustand] += 1;
-    offenePunkte.push(...offenePunkteVon(k));
-  }
-  return { anzahl: liste.length, jeZustand, offenePunkte };
-}
