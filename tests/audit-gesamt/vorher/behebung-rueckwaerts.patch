-    return { zustand: "unbekannt", grund: spur.grund };
-  }
-  const { ergebnis } = spur.wert;
-  if (ergebnis !== "erfolg" && ergebnis !== "fehler") {
-    return { zustand: "unbekannt", grund: "ungueltig" };
