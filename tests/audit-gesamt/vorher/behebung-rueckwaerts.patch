-export interface GedaechtnisEingabe {
-  art?: unknown;
-  inhalt?: unknown;
-  antwort?: unknown;
-  antwortId?: unknown;
-  vertraulichkeit?: unknown;
-  aufbewahrungTage?: unknown;
-  darstellung?: unknown;
-  fassung?: unknown;
-  aufbewahrungAusnahme?: unknown;
