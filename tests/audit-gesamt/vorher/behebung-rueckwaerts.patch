-    runSweep: pruefe,
-    ...(deps.setIntervalFn ? { setIntervalFn: deps.setIntervalFn } : {}),
-    ...(deps.clearIntervalFn ? { clearIntervalFn: deps.clearIntervalFn } : {}),
-    ...(deps.onError ? { onError: deps.onError } : {}),
-  });
-}
