-  /** EIN Vorkommen absagen, erledigen, verschieben oder die Einzeländerung zurücknehmen. */
-  async vorkommen(
-    kontoId: string,
-    id: string,
-    schluessel: string,
-    eingabe: { fassung?: unknown; aktion?: unknown; datum?: unknown; uhrzeit?: unknown },
-  ): Promise<KlaraErinnerungEintrag> {
