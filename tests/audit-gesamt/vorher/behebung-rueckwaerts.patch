-    for (const gap of m.luecken) {
-      await schritt("luecke", gap.id, () => this.q.assignGap(gap.id, an));
-    }
-    for (const z of m.pruefaufgaben) {
-      await schritt("pruefaufgabe", z.koId, () => this.pruefaufgabeUebergeben(z.koId, von, an));
-    }
