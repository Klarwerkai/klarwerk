-export class JiraRequestError extends Error {
-  readonly lage: JiraFehlerlage;
-
-  constructor(lage: JiraFehlerlage) {
-    super(LAGE_MELDUNG[lage]);
-    this.name = "JiraRequestError";
-    this.lage = lage;
-  }
