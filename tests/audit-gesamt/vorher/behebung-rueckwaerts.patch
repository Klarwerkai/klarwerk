-
-/** Fügt einen nicht leeren Wert an, wenn er noch fehlt (Quell-Reihenfolge bleibt). */
-function merke(liste: string[], wert: string | undefined): void {
-  const sauber = wert?.trim();
-  if (sauber && !liste.includes(sauber)) {
-    liste.push(sauber);
-  }
-}
-
