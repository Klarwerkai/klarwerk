-    zustand: ergebnis,
-    zeitUtc: zeitAusSpur(spur.wert.zeit),
-    exitcode: zahlOderNull(spur.wert.exitcode),
-    grund: textOderNull(spur.wert.grund) ?? "",
-    datei: textOderNull(spur.wert.datei),
