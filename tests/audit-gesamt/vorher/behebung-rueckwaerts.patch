-      if (lage === "quelle_nicht_mehr_erreichbar") {
-        return `Quelle nicht mehr erreichbar (festgestellt ${am})`;
-      }
-      if (lage === "quelle_geaendert") {
-        const kurz = (aktuell ?? "").slice(0, 12);
