-
-/** Das Ergebnis einer Klärung — immer auf genau diesen Schlüssel bezogen. */
-export type BegleiterKlaerung =
-  | { stand: "angenommen"; instanz: string; aktion: BegleiterAktion }
-  | { stand: "nicht_angelegt" }
