-function fuegeNotizAn(notizXml: string, zeilen: readonly string[]): string | undefined {
-  for (const form of notizXml.matchAll(FORM)) {
-    const inhalt = form[1] ?? "";
-    const ende = inhalt.lastIndexOf("</p:txBody>");
-    if (!/<p:ph\s[^>]*type="body"/.test(inhalt) || ende < 0) {
