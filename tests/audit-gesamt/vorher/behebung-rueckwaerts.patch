-  private async lesbareQuellen(wer: KiBetrachter, e: KiAuftragEintrag): Promise<Set<string>> {
-    const ids = [
-      ...new Set([
-        ...e.quellen,
-        ...e.paket.quellenstand.map((q) => q.quelleId),
-        ...e.paket.ausgelassen.map((a) => a.quelleId),
-      ]),
-    ];
