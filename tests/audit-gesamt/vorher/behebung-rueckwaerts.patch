-        }
-        const body = (request.body ?? {}) as {
-          version?: unknown;
-          grundlage?: unknown;
-          begruendung?: unknown;
-        };
-        if (body.version !== space.version) {
-          reply.code(409).send({
-            error: "VERSION_VERALTET",
-            message: "Der Space wurde inzwischen geändert. Bitte neu laden.",
-            aktuelleVersion: space.version,
