-  const body = (res as { body?: ReadableStream<Uint8Array> | null }).body;
-  if (body && typeof body.getReader === "function") {
-    const reader = body.getReader();
-    const stuecke: Buffer[] = [];
-    let gelesen = 0;
-    for (;;) {
-      const { done, value } = await reader.read();
-      if (done) {
