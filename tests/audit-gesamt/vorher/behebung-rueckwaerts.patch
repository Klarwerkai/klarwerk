-    const routine = await this.routineGeprueft(kontoId, { wissenspflege: roh }, 1);
-    return {
-      auftrag: routine.wissenspflege,
-      ergebnis: "pruefunterlagen_in_eigenen_notizen",
-      wirkung: "keine",
-    } as const;
-  }
