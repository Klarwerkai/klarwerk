-/** Wie der Wert in Klarwerk gekommen ist (Abschnitt 4: Kennzeichnung). */
-export type Erfassung = "direkt" | "ocr" | "manuell" | "berechnet" | "prognose";
-export const ERFASSUNGEN: readonly Erfassung[] = [
