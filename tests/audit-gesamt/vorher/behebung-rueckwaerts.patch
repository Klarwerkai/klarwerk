-export interface PaarpflichtBeanspruchung {
-  token: string;
-  jetzt: string;
-  bis: string;
-  maxFehlversuche: number;
-  // In diesem Aufruf schon bearbeitet — nicht noch einmal fragen (z. B. nach „kein_modell").
-  ausser: readonly string[];
-}
