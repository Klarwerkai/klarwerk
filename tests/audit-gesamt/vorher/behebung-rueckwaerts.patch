-/** Ohne eigene Angabe: genau ein Jahr vor jetzt (R-1630: „Stand vor 12 Monaten"). */
-export const WISSENSSTAND_STANDARD_ABSTAND_TAGE = 365;
-
-const TAG_MS = 24 * 60 * 60 * 1000;
