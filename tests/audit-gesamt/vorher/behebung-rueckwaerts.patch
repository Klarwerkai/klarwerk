-  private nimmAn(
-    s: Lernsitzung,
-    client: string | null,
-    host: unknown,
-    vorgang: unknown,
-    beschreibungRoh: unknown,
-    rohwertRoh: unknown,
-    neuerEntwurf: string | null = null,
