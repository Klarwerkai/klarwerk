-      throw new RoutineEingabeFehler(
-        "eingabe",
-        fehler instanceof Error ? fehler.message : "Ungültiger Pflegeauftrag.",
-      );
-    }
-  }
-  const abschnitteRoh =
-    r.abschnitte ?? (wissenspflege ? [] : ["offene_aufgaben", "erledigte_aufgaben"]);
