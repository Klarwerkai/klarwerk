-    gueltig: false as const,
-    grund,
-    aktion: folgeaktionFuer(grund),
-  });
-  const { marke, bindung } = lage;
-  if (marke.act !== bindung.actorId) {
-    return nein("konto_gewechselt");
-  }
-  if (marke.sid !== bindung.sessionId) {
-    return nein("sitzung_gewechselt");
