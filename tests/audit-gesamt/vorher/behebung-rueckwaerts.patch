-  ): Promise<T> {
-    for (let versuch = 0; versuch < 8; versuch++) {
-      const alt = await this.deps.ablage.liste(nutzer);
-      const { neu, wert } = f(alt);
-      if (neu === null || (await this.deps.ablage.ersetze(nutzer, alt, kuerze(neu)))) {
