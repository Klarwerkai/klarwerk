-/** Fingerabdruck des ganzen Vertrags — jede Änderung (auch ohne Fassungssprung) ändert ihn. */
-export function vertragsFingerabdruck(v: Faehigkeitsvertrag): string {
-  return sha256(kanonisch(v));
