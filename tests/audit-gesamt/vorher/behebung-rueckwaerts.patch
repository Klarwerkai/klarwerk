-    return false;
-  }
-  // Ben Nacharbeit 3: eine Herkunftssperre der Anfrage hebt keine Freigabe auf.
-  if (bindung?.ausleitungGesperrt === true) {
-    return false;
-  }
-  if (!bindung?.gebunden) {
-    return true;
-  }
-  return bindung.anbieter !== null && anbieter === bindung.anbieter;
-}
