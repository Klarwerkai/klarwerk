-    this.laufSperren.set(schluessel, gemerkt);
-    try {
-      return await jetzt;
-    } finally {
-      if (this.laufSperren.get(schluessel) === gemerkt) {
-        this.laufSperren.delete(schluessel);
-      }
-    }
