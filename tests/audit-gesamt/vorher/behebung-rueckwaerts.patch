-  ): KiAuftragEintrag {
-    const annahme = nimmAntwortAn(
-      [e.job],
-      {
-        jobId: e.job.jobId,
-        sitzungId: e.job.bindung.sitzungId,
-        anbieter: a.anbieter,
-        inhalt: a.inhalt,
-      },
-      a.aktuell,
-    );
-    if (!annahme.angenommen) {
-      throw new KiArbeitsbegleitungFehler(409, "gesperrt", `Antwort abgelehnt (${annahme.grund}).`);
-    }
-    return {
-      ...e,
-      job: annahme.job,
-      antworten: [
-        ...e.antworten,
-        {
-          am: jetzt,
-          inhalt: a.inhalt,
-          anbieter: a.anbieter,
-          modell: a.modell,
-          weg: a.weg,
-          paketId: annahme.paketId,
