-  /** Ein Takt. Läuft schon einer, wird auf ihn gewartet (nie zwei gleichzeitig). */
-  lauf(jetzt: number = Date.now()): Promise<ZeitplanLaufErgebnis[]> {
-    if (!this.laeuft) {
-      this.laeuft = this.arbeite(jetzt).finally(() => {
-        this.laeuft = null;
-      });
-    }
-    return this.laeuft;
