-function emailAus(objekt: Record<string, unknown>): string | undefined {
-  const name = text(objekt.userName);
-  if (name) {
-    return name;
-  }
-  const emails = Array.isArray(objekt.emails) ? (objekt.emails as Record<string, unknown>[]) : [];
