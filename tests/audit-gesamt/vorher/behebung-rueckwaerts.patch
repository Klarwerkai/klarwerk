-export const KLARA_FRISTEN_SCHEMA = `
-CREATE TABLE IF NOT EXISTS klara_fristen (
-  konto_id text PRIMARY KEY,
-  fassung integer NOT NULL,
-  data jsonb NOT NULL
-);
-`;
