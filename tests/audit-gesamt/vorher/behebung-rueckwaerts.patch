-    pruefer: kennungen(r.pruefer, konten, FREIGABE_GRENZEN.pruefer, "Die Prüfer"),
-    prueferTeams: kennungen(r.prueferTeams, teams, FREIGABE_GRENZEN.teams, "Die Prüferteams"),
