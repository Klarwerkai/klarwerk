-  }
-  if (abschnitt && /\b(weg|ohne|entfern|nicht mehr|streich)\b/.test(t)) {
-    return { art: "abschnitt_weg", abschnitt };
-  }
-  if (/\b(pausier|pause|aussetz|anhalten)/.test(t)) {
-    return { art: "pausieren" };
