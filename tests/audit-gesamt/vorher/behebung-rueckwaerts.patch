-function datenwegText(v: Faehigkeitsvertrag): string {
-  const ziel =
-    v.datenempfaenger.art === "intern"
-      ? "bleibt in Klarwerk"
-      : `an ${v.datenempfaenger.anbieterName} (${v.datenempfaenger.host})`;
-  const unter = v.unterschritte.map(
