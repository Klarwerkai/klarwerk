-  const bytes = gespeichert ? decodeDataUrl(gespeichert.data)?.bytes : undefined;
-  if (!bytes) {
-    throw new NachbearbeitungsFehler("KEINE_PRAESENTATION", "Der Dokumentstand ist nicht lesbar.");
