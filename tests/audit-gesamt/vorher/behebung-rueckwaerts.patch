-          von: veroeffentlicher,
-          am,
-          empfaenger,
-        };
-      },
-      async (geschrieben, tx) => {
-        await this.deps.zustellungen.anlegen(
-          kreis.map((empfaengerId) => ({
-            vermerkId: geschrieben.id,
-            koId: ko.id,
-            empfaengerId,
-            am: geschrieben.am,
-            hervorgehoben: geschrieben.meldung === "hervorgehoben",
