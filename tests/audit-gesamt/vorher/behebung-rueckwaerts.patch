-
-export interface KlaraErinnerungVorkommen {
-  readonly id: string;
-  readonly schluessel: string;
-  /** Der wirksame Zeitpunkt (ms) — `null`, wenn ausgelassen (Sommerzeitlücke, Regel „auslassen"). */
