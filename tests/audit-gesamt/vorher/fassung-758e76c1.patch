-  { methode: "POST", pfad: "/api/check-text", recht: "checktext.validated" },
-  {
-    methode: "GET",
-    pfad: "/api/library/export",
-    recht: "export.validated",
-    sitzungsrolle: "viewer",
-  },
-  {
-    methode: "POST",
-    pfad: "/api/library/import/candidates",
