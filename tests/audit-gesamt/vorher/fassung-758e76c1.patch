-  if (!hatSchutzbezug(angaben)) {
-    return gewaehlt;
-  }
-  if (
-    gewaehlt === undefined ||
-    confidentialityRank(gewaehlt) < confidentialityRank(NEGATIVWISSEN_MINDESTSTUFE)
-  ) {
-    return NEGATIVWISSEN_MINDESTSTUFE;
-  }
-  return gewaehlt;
