-    const liste = await this.holeJson(`${this.baseUrl}/rest/api/2/project/${projekt}/role`);
-    if (!liste || typeof liste !== "object" || Array.isArray(liste)) {
-      throw new JiraRequestError("nicht-erreichbar");
-    }
