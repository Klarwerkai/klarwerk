-export const MITGELESEN_SCHEMA = `
-CREATE TABLE IF NOT EXISTS ko_mitgelesen (
-  ko_a text NOT NULL,
-  ko_b text NOT NULL,
-  anzahl integer NOT NULL,
-  PRIMARY KEY (ko_a, ko_b)
-);
-CREATE INDEX IF NOT EXISTS idx_ko_mitgelesen_b ON ko_mitgelesen (ko_b);
-`;
