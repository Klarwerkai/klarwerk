-      }
-      const vorlage = (await vorlagenFassungen(deps.ablage, bezug.id)).find(
-        (f) => f.version === bezug.version,
-      );
-      const am = jetzt().toISOString();
-      const eintrag: NutzungsEintrag = {
-        koId,
-        version: 1,
