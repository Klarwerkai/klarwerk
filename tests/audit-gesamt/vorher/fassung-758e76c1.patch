-  const passend = (a: DiscoveryAktion) =>
-    a.name === args.aktion && (a.ext === args.endung || a.app === args.mime);
-  const treffer = args.aktionen.find(passend);
-  if (!treffer) {
-    return undefined;
-  }
-  const quelle = new URL(treffer.urlsrc.replace(/<[^>]*>/g, ""));
