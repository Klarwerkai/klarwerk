-  private leseRollen(): Promise<JiraRollenbesetzung> {
-    this.rollen ??= this.client.leseRollenbesetzung().catch((err: unknown) => {
-      this.rollen = undefined;
-      if (jiraFehlerlage(err) === "keine-berechtigung") {
