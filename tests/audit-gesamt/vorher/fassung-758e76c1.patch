-  if (
-    breite < LOGO_GRENZEN.minKante ||
-    hoehe < LOGO_GRENZEN.minKante ||
-    breite > LOGO_GRENZEN.maxKante ||
-    hoehe > LOGO_GRENZEN.maxKante
