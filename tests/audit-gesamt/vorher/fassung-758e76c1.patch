-export interface PaarpflichtServiceDeps {
-  repo: PaarpflichtRepo;
-  jetzt?: () => Date;
-  token?: () => string;
-  // Wie lange eine Beanspruchung gilt, bevor ein anderer Lauf die Pflicht übernimmt.
