-    this.pruefeHaltbarkeit();
-    const neu = [...new Set(empfaenger)].filter(
-      (id) =>
-        !this.eintraege.has(
-          InMemoryKenntnisnahmeRepo.schluessel(anforderung.koId, anforderung.fassung, id),
-        ),
