-
-function kommtVor(text: string, benennung: string): boolean {
-  const kern = benennung
-    .trim()
-    .split(/\s+/)
-    .map((teil) => teil.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"))
-    .join("\\s+");
-  if (!kern) {
-    return false;
-  }
-  return new RegExp(`(?<![\\p{L}\\p{N}_])${kern}(?![\\p{L}\\p{N}_])`, "iu").test(text);
-}
