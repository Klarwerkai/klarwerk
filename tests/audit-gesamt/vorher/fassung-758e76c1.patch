-  if (wert.length < grenzen.min || wert.length > grenzen.max) {
-    throw new UnternehmenFehler(
-      400,
-      code,
-      `Das Feld „${feld}" muss zwischen ${grenzen.min} und ${grenzen.max} Zeichen lang sein.`,
-      { feld, min: grenzen.min, max: grenzen.max },
