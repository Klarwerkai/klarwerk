-    const konflikte = [...offen, ...entschieden].filter(
-      (k) => k.koA === center.id || k.koB === center.id,
-    );
-    const kandidaten = new Set<string>([
-      ...thema.map((n) => n.id),
-      ...konflikte.map((k) => (k.koA === center.id ? k.koB : k.koA)),
-      ...mitgelesen.map((p) => p.koId),
