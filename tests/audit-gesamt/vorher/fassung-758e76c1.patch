-}
-
-type Weg = "direkt" | "vorschlag";
-
-interface SpeicherRumpf {
-  entwurfId?: unknown;
-  basisRevision?: unknown;
-  titel?: unknown;
-  /** Der Inhalt als HTML (einheitlicher Editor). */
-  rumpf?: unknown;
