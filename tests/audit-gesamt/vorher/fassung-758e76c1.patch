-// geschlossenem Eintrag eine exakte Rückstellung.
-const schliessenErfassen: Erfassung = async (ziel, echt, args, vorgang) => {
-  const alle = (await gebunden<() => Promise<{ id: string }[]>>(ziel, "all")()) ?? [];
