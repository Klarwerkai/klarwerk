-    quellen.wissensobjekte(),
-    quellen.revalidierungFaellig(),
-    quellen.offeneWidersprueche(),
-  ]);
-  const sichtbar = new Map<string, KnowledgeObject>();
-  for (const ko of kos) {
-    if (meldbar(ko)) {
-      sichtbar.set(ko.id, ko);
-    }
-  }
-  return { sichtbar, faellig, widersprueche };
-}
