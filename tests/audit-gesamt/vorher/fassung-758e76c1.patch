-      }
-    });
-
-    app.post<{ Params: { anforderungId: string } }>(
-      "/api/kenntnisnahmen/:anforderungId/erinnern",
-      async (request, reply) => {
-        const user = await guards.requirePermission("ko.assign", request, reply);
-        if (!user) {
-          return;
