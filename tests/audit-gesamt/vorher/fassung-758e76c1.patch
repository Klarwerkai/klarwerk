-CREATE TABLE IF NOT EXISTS meldung_zustellstatus (
-  vermerk_id text NOT NULL,
-  ko_id text NOT NULL,
-  empfaenger_id text NOT NULL,
-  kanal text NOT NULL,
-  status text NOT NULL,
-  angelegt_am timestamptz NOT NULL,
-  versuch_am timestamptz,
