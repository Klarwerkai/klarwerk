-  }
-  if (!roh || typeof roh !== "object") {
-    return "unlesbar";
-  }
-  const { x, y } = roh as Record<string, unknown>;
-  const imBild = (w: unknown): w is number =>
-    typeof w === "number" && Number.isFinite(w) && w >= 0 && w <= 1;
-  if (!imBild(x) || !imBild(y)) {
-    return "unlesbar";
-  }
