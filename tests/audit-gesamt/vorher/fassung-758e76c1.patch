-    if (offen) {
-      throw new JournalAusgangUngewiss(offen.vorgang, offen.fehler);
-    }
-  };
-  return {
-    write: (entry) => {
-      blockiert();
-      write(entry);
-    },
-    vorgangAbschluss: (zeilen) => {
-      blockiert();
-      const vorgang = randomUUID();
-      const zeile: VorgangsEintrag = {
-        repo: VORGANG_ZEILE.repo,
-        method: VORGANG_ZEILE.method,
