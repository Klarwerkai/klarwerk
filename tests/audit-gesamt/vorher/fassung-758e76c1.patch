-        version: f.version,
-        at: f.at,
-        author: f.author,
-        objectId,
-      });
-    }
-  }
-  const herkunft = new Map(
-    ko.history
-      .filter((h) => h.anhangGeaendert === anhangId && h.anhangZurueckAus !== undefined)
-      .map((h) => [h.version, h.anhangZurueckAus as number] as const),
