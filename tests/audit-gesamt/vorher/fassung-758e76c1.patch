-    const id = typeof e.id === "string" ? e.id : "";
-    if (!KENNUNG.test(id)) {
-      fehler.push(`Eintrag ${i + 1}: Kennung fehlt oder ist ungültig (a-z, 0-9, Bindestrich).`);
