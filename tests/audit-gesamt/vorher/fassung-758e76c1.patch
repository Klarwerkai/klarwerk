-
-export const ANLAGENKONTEXT_FELDER = [
-  "bauteile",
-  "materialien",
-  "versionen",
-  "standorte",
-  "schichten",
-] as const satisfies readonly (keyof AnlagenKontext)[];
-
-/** Höchstzahl der Einträge je Liste und Höchstlänge je Kennung — geprüft an der Route (400). */
