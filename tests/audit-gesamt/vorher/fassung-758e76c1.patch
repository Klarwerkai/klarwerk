-    await this.pool.query(
-      `INSERT INTO ko_mitgelesen (ko_a, ko_b, anzahl) VALUES ($1, $2, 1)
-       ON CONFLICT (ko_a, ko_b) DO UPDATE SET anzahl = ko_mitgelesen.anzahl + 1`,
