-  const { dienst, kos } = deps;
-
-  /** Der Eintrag, wenn dieses Konto ihn sehen darf — sonst `undefined` (Antwort 404). */
-  async function sichtbaresKo(
-    user: SessionUser,
-    koId: string,
-  ): Promise<KnowledgeObject | undefined> {
-    const ko = await kos.get(koId);
