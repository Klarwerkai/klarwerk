-  let grund: unknown;
-  let zurueck = false;
-  const beiFehler = (fehler: Error): void => {
-    grund ??= fehler;
-  };
-  if (typeof client.on === "function") {
-    client.on("error", beiFehler);
-  }
-  return {
-    verwerfen(neu: unknown) {
-      grund ??= neu ?? true;
-    },
-    get unsauber() {
-      return grund !== undefined;
-    },
-    zurueckgeben(zusatz?: unknown) {
-      if (zurueck) {
-        return;
-      }
-      zurueck = true;
-      if (typeof client.removeListener === "function") {
