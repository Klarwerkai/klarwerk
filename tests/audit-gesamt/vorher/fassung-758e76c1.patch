-    return (
-      can(user.role, "ko.create") &&
-      (responsibleOf(ko) === user.id || can(user.role, "ko.validate"))
-    );
-  }
-
-  darfEntscheiden(user: Handelnder): boolean {
-    return can(user.role, "ko.validate");
-  }
