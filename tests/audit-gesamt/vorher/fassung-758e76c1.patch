-  text?: unknown;
-  basisStand?: unknown;
-}
-
-interface AngleichRumpf {
-  entwurfId?: unknown;
-  revision?: unknown;
-  aufgeloest?: unknown;
-}
-
-interface AbschlussRumpf {
-  entwurfId?: unknown;
