-  b: KoGeltung | undefined,
-): { art: "context" | "role"; vermerk: string } | null {
-  if (!a || !b) {
-    return null;
-  }
-  const ortGleich = a.ebene === b.ebene && gleich(a.werk, b.werk) && gleich(a.schicht, b.schicht);
