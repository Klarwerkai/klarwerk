-/** Die Form einer mitgebrachten Kennung — eine UUID, wie `randomUUID` sie vergibt. */
-const DOKUMENT_ID_FORM = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
