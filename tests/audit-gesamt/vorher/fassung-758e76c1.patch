-): { passung: GeltungsPassung; rang: number } {
-  const passung = passungVon(geltung, kontext);
-  return { passung, rang: RANG[passung] };
-}
-
-function passungVon(geltung: KoGeltung | undefined, kontext: Fragekontext): GeltungsPassung {
