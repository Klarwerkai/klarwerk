-      this.deps.thema(center.id, sichtbar),
-      this.deps.konflikte.unresolved(),
-      this.deps.konflikte.vorrangFuerKo(center.id),
-      this.deps.repo.partner(center.id, MITGELESEN_MINDESTENS, MITGELESEN_PARTNER_MAX),
