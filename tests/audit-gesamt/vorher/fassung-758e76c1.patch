-export function paarpflichtLaufkopf(
-  laufId: string,
-  aussagen: readonly PaarpflichtAussage[],
-  kontext: PaarpflichtKontext,
-  jetzt: string,
-): PaarpflichtLauf {
-  return {
-    laufId,
-    aussagen: [...aussagen]
-      .sort((p, q) => (p.refId < q.refId ? -1 : 1))
-      .map((a) => ({ ...a, quellen: [...a.quellen].sort() })),
-    kontext: { ...kontext },
-    angelegt: jetzt,
-  };
