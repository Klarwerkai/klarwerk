-        throw new JiraRequestError(lage);
-      }
-      if (!res.ok) {
-        throw new JiraRequestError("nicht-erreichbar");
-      }
-      try {
-        return await Promise.race([leseBegrenzt(res, maxBytes), frist]);
-      } catch (err) {
-        if (jiraFehlerlage(err) !== null) {
-          throw err;
-        }
