-function kern(ko: KnowledgeObject): string {
-  const subjekt: DetectSubject = {
-    refId: ko.id,
-    title: ko.title,
-    statement: ko.statement,
-    conditions: ko.conditions,
-    measures: ko.measures,
-    tags: ko.tags,
