-  private async stelleZu(): Promise<Omit<LaufErgebnis, "erkannt" | "ausstehend">> {
-    let zugestellt = 0;
-    let gescheitert = 0;
-    let abgebrochen = 0;
-    const offen: Ausstehend[] = [];
-    for (const eintrag of this.warteschlange) {
