-      fehler.push(`Eintrag ${i + 1} (${id}): sha256 braucht 64 Hexzeichen je Schlüssel.`);
-      continue;
-    }
-    if (summen.some((s) => vergebeneSummen.has(s))) {
-      fehler.push(
