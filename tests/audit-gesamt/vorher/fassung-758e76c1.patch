-function erfolgsinhalt(erfolg: Vertragsroute["erfolg"]): Record<string, unknown> {
-  if (erfolg === "export") {
-    return {
-      "application/json": { schema: { type: "array", items: ref("Wissensobjekt") } },
-      "text/markdown": TEXT,
-      "text/plain": TEXT,
-      "text/html": TEXT,
