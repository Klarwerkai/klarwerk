-  return (
-    a.koVersion === b.koVersion &&
-    a.art === b.art &&
-    a.abschnitt === b.abschnitt &&
-    a.text === b.text &&
-    a.fingerabdruck === b.fingerabdruck &&
-    a.seite === b.seite &&
-    a.punkt?.x === b.punkt?.x &&
-    a.punkt?.y === b.punkt?.y
-  );
-}
