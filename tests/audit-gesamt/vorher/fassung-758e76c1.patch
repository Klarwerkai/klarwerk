-function klartextAlsHtml(text: string): string {
-  const maskiere = (s: string): string =>
-    s
-      .replaceAll("&", "&amp;")
-      .replaceAll("<", "&lt;")
-      .replaceAll(">", "&gt;")
-      .replaceAll('"', "&quot;");
-  return text
-    .replace(/\r\n?/g, "\n")
-    .split(/\n{2,}/)
-    .map((absatz) => absatz.trim())
-    .filter((absatz) => absatz.length > 0)
-    .map((absatz) => `<p>${maskiere(absatz).replaceAll("\n", "<br />")}</p>`)
