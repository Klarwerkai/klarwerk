-  // Nach dem Speichern: der Abgleich darf die Antwort nicht mehr kippen (s. `nachAenderung`).
-  const nachAenderung = async (request: FastifyRequest): Promise<void> => {
-    try {
-      await deps.nachAenderung?.();
