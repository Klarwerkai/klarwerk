-  // Die Kontowege, nach denen ein Konto befristet UND mit Bearbeitungsrecht dastehen kann.
-  const KONTOWEGE = new Set([
-    "PUT /api/users/:id",
-    "POST /api/users",
-    "POST /api/auth/users/:id/approve",
