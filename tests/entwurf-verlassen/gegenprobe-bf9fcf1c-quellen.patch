+}
+
+describe("Berater-Konzept Duplikate 04.07. (Stufe D1): Erkennungskern", () => {
+  it.each(["", "Anderer Dokumentname"])(
+    "gleicher nichtleerer Inhalt bleibt bei Anfragetitel '%s' deterministisch und symmetrisch",
+    (title) => {
