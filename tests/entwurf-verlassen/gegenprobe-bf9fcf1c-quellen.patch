+    // … und das Kurzfeld, auf dem die Vorauswahl rechnet, ist Zeichen für Zeichen das alte.
+    const aussage = (b.kerne[0] as string).split("\n").slice(0, 2).join("\n");
+    expect(aussage).toBe(a.kerne[0]);
+  });
+
