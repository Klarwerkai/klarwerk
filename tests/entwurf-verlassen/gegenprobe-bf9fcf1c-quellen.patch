+      api.post<Anweisung>(`/gesamtanweisungen/${id}/vorlegen`, { version }),
+    entscheiden: (id: string, version: number, entscheidung: "angenommen" | "abgelehnt") =>
+      api.post<Anweisung>(`/gesamtanweisungen/${id}/entscheiden`, { version, entscheidung }),
+  },
+};
