+                      {t("adm.ready.demo.goto")}
+                    </button>
+                  ) : null}
+                  <span
+                    className={`ml-auto rounded-pill px-2.5 py-0.5 text-[11.5px] font-semibold ${
+                      READY_TONE_CLASS[row.tone]
+                    }`}
+                  >
+                    {row.params ? t(row.valueKey, row.params) : t(row.valueKey)}
+                  </span>
+                </li>
+              ))}
+            </ul>
+          </>
+        )}
+      </Detailkarte>
+    </div>
+  );
+}
