+      alreadyQueued: true,
+    });
+    await services.library.reviewImportCandidate(p1.id, "accept", "tester");
+    // Angenommen (lebendes KO mit Herkunftsanker, Kandidat geschlossen) → importiert, nicht mehr vorgemerkt.
