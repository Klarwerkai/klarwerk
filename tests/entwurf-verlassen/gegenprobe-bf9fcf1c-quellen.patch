+ * werden. Eine Erlaubnisliste nimmt neue Felder schlicht nicht mit — Vergessen führt zu weniger im
+ * Log, nicht zu mehr.
+ */
+export function baueLoggerOptionen(vorgabe?: {
+  senke?: LogSenke;
+  stufe?: string;
