+        popover: "var(--kw-shadow-popover)",
+        tile: "var(--kw-shadow-tile)",
+      },
+      fontSize: {
+        micro: ["10.5px", { lineHeight: "1.2", letterSpacing: "0.5px" }],
+      },
+    },
+  },
+  plugins: [],
+} satisfies Config;
