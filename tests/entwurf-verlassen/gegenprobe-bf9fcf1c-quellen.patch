+    expect(await provider.search("xyz")).toEqual([]);
+  });
+
+  it("stripHtml entfernt Tags + Entities; articleUrl ersetzt Leerzeichen", () => {
+    expect(stripHtml("<b>A</b>&amp;B  C")).toBe("A&B C");
