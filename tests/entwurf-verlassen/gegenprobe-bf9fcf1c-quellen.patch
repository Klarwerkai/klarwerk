+          return false;
+        }
+        if (e.koAVersion === undefined && e.koBVersion === undefined) {
+          return true; // Altbestand-Eintrag → wie bisher blocken
+        }
+        if (aVer === undefined || bVer === undefined) {
+          return true; // versionsloser Lauf → konservativ blocken
+        }
