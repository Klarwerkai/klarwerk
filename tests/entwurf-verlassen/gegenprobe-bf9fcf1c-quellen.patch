+  it("DER FIXPUNKT: zweimal sanitisieren aendert nichts mehr", () => {
+    // DIE EIGENTLICHE ZUSICHERUNG. Sie gilt fuer die ganze Reihe, nicht fuer einen Fall.
+    for (const fall of FAELLE) {
