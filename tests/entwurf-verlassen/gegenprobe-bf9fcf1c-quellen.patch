+    const service = new ConflictService({ repo: new InMemoryConflictRepo(), audit });
+    const c = await service.create(
+      { koA: "a", koB: "b", type: "truth", description: "x" },
+      "system",
+    );
+    await service.dismiss(c.id, "controller", "Fehlalarm: andere Anlage");
