+  async addProposal(
+    id: string,
+    author: string,
+    input: {
+      statement: string;
+      bodyHtml?: string | null;
+      clearBody?: boolean;
+      baseVersion: number;
+      origin?: string;
+    },
+  ): Promise<{ ko: KnowledgeObject; proposal: KoProposal }> {
