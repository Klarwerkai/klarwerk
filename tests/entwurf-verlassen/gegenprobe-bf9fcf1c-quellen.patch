+  anker: EditableElement | null,
+  bild: EditableElement,
+): { offen: boolean; fussnote: EditableElement | null } {
+  const zu = { offen: false, fussnote: null };
+  if (anker === null) {
+    return { offen: true, fussnote: null };
+  }
+  const direkte = alle(anker, ":scope > figcaption");
+  if (direkte.length === 0) {
+    return { offen: true, fussnote: null };
