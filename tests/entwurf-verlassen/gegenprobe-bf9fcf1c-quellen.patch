+    measures: [],
+    type: "best_practice",
+    category: "Anlage 1",
+    tags: [],
+    confidence: 0,
+    trust: 80,
+    status: "validiert",
+    version: 1,
+    originalAuthor: "a",
+    author: "a",
+    neededValidations: 3,
+    assignments: [],
+    asset: null,
+    createdAt: "2026-06-20",
