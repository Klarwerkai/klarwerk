+ * Abfrage mitschickte, stellte sie nebenbei zurück — derselbe Fehler, anderes Feld.
+ */
+interface KiStand {
+  readonly global: string;
+  readonly perTask: Record<string, string>;
+  readonly freigabe: KiFreigabeStand;
+}
