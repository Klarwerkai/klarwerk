+        }
+      },
+    );
+
+    // IC-1 (Import-Cockpit): READ-ONLY Erkundung — „was ist da" VOR jedem Import. Liest den Space
+    // (collectAll), aggregiert Mengen/Autoren/Themen/Zeitraum und gibt sie zurück. Schreibt NICHTS:
