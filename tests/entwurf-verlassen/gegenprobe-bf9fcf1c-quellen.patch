+    synced: 0,
+    failed: 0,
+    stale: 0,
+    ohneVoraussetzung: 0,
+    fremd: 0,
+    ohneBindung: 0,
+    kontoUnbekannt: false,
+    abgebrochen: 0,
+    auffrischungLaeuft: 0,
+  };
