+            seite="b"
+            ton="duplikat"
+            titel={pair.b?.title ?? t("board.koRemoved")}
+            meta={metaVon(pair.b, t)}
+            teile={teileB}
+            aktionen={aktionen("b")}
+            mehr={mehr("b")}
+          />
