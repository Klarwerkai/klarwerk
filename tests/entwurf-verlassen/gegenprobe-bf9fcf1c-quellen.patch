+  pruefname?: string;
+}
+
+const CHEVRON = (
+  <svg
+    width="12"
+    height="12"
+    viewBox="0 0 24 24"
+    fill="none"
+    stroke="#9AA2B1"
+    strokeWidth="2"
+    strokeLinecap="round"
+    strokeLinejoin="round"
+    aria-hidden="true"
+  >
+    <title>·</title>
+    <path d="M6 9l6 6 6-6" />
+  </svg>
