+  // Ablauf-Zeitpunkt der Endlöschung eines getrashten KO.
+  private trashExpiry(deletedAt: string): number {
+    return Date.parse(deletedAt) + TRASH_RETENTION_DAYS * 24 * 60 * 60 * 1000;
+  }
