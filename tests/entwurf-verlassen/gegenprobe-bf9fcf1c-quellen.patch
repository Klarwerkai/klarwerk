+  const kritischeLuecken =
+    typeof gapsSummary.data?.byPriority?.hoch === "number" ? gapsSummary.data.byPriority.hoch : 0;
+  const arbeit = buildWorkOverview({
+    ...workSignalsFrom({
+      board: board.data ?? [],
+      conflicts: conflicts.data ?? [],
+      revalidation: pending.data ?? [],
