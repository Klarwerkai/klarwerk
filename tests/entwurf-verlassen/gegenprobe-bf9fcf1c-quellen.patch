+    const { ko } = koService([mkKo("v2", "validiert", TEXT_MITTEL)]);
+    const judge = vi.fn(async (): Promise<OverlapVerdict | null> => teilweiseVerdict);
+    const prefilter = throwingEmbedPrefilter(new ModelCapacityError("Embedder ausgelastet."));
