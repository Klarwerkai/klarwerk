+      const c = next.perTask?.[task];
+      if (c === undefined) continue;
+      if (!isValidReasonerChoice(c)) {
+        throw new Error(`Ungültige KI-Zuordnung für Aufgabe '${task}'.`);
+      }
+      const wahl = this.migriereWahl(c);
