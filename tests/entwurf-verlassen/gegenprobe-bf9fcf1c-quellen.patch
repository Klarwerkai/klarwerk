+function docxDraftTooLargeErrorHandler(
+  error: FastifyError,
+  _request: FastifyRequest,
+  reply: FastifyReply,
+): void {
+  if (error.code !== "FST_ERR_CTP_BODY_TOO_LARGE") {
+    reply.send(error);
+    return;
