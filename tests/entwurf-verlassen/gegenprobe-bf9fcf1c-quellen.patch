+    expect(confluenceSourcePath(tief)).toEqual(["Handbuch", "Betrieb", "Ventile"]);
+    // Die Seite selbst gehört NICHT in ihren eigenen Pfad — sonst stünde sie im Ordnerbaum
+    // als Ordner UND als Zeile darin.
