+}
+
+describe("ManagementService (SCRUM-120)", () => {
+  it("baut einen Snapshot aus echten Service-Daten", async () => {
+    const svc = await makeService([ko({ id: "K1" }), ko({ id: "K2", status: "offen", trust: 40 })]);
