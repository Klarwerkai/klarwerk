+      "source_body_sha256": "83a643d2e82f769f30f40c5b774374ac08bee2b2bbdef69f60b8be4a2a47283a",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "Harbor order record",
+        "paragraphs": [
+          "Harbor Field Services has requested a workplace setup and branch network handover. The record contains a proposal, but no signed acceptance is attached.",
+          "An additional request for weekend support has been discussed. No written approval for that additional service is attached.",
+          "The current record therefore does not prove approval of either the base order or weekend support."
+        ]
+      },
+      "de": {
+        "title": "Harbor-Auftragsakte",
+        "paragraphs": [
+          "Harbor Field Services hat eine Arbeitsplatzeinrichtung und die Übergabe des Niederlassungsnetzes angefragt. Die Akte enthält ein Angebot, aber keine beigefügte unterschriebene Annahme.",
+          "Eine zusätzliche Anfrage nach Wochenendsupport wurde besprochen. Für diese Zusatzleistung ist keine schriftliche Freigabe beigefügt.",
+          "Die aktuelle Akte belegt daher weder die Freigabe des Basisauftrags noch des Wochenendsupports."
+        ]
+      }
+    },
+    {
+      "key": "C07",
+      "semantic_id": "C07",
+      "original_language": "en",
+      "confluence_id": "25067532",
+      "confluence_url": "https://klarwerk.atlassian.net/wiki/spaces/K/pages/25067532/DEMO+C07+Checking+customer-approved+changes",
+      "source_body_sha256": "08c450a58823862379f7d000f5b7785b763fdb2094e2c70b6f3ce5e8b2a62888",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "Checking customer-approved changes",
+        "paragraphs": [
+          "Additional work requires written customer approval before delivery starts.",
+          "The approval record identifies the scope, the agreed price basis and the authorised customer representative.",
+          "If the approval cannot be found, report the evidence gap. A colleague saying that approval is likely is not sufficient."
+        ]
+      },
+      "de": {
+        "title": "Prüfung kundenseitig freigegebener Änderungen",
+        "paragraphs": [
+          "Zusätzliche Leistungen benötigen eine schriftliche Kundenfreigabe, bevor die Umsetzung beginnt.",
+          "Der Freigabenachweis nennt den Umfang, die vereinbarte Preisgrundlage und den bevollmächtigten Kundenvertreter.",
+          "Wenn die Freigabe nicht auffindbar ist, melde die Nachweislücke. Die Aussage eines Kollegen, eine Freigabe sei wahrscheinlich, reicht nicht aus."
+        ]
+      }
+    },
+    {
+      "key": "C08",
+      "semantic_id": "C08",
+      "original_language": "en",
+      "confluence_id": "24838170",
+      "confluence_url": "https://klarwerk.atlassian.net/wiki/spaces/K/pages/24838170/DEMO+C08+Purchase+approval",
+      "source_body_sha256": "3f4f7c127adf2518d9d4bd087f2459f7ec6db58f22f7eabd7fc0b55be6e52c9e",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "Purchase approval",
+        "paragraphs": [
+          "A supplier purchase must identify the requesting colleague, the customer job and the approver.",
+          "For this demo, purchases above EUR 500 require written approval from the delivery lead before ordering.",
+          "A supplier quotation does not prove that an order was placed or equipment received."
+        ]
+      },
+      "de": {
+        "title": "Beschaffungsfreigabe",
+        "paragraphs": [
+          "Eine Lieferantenbestellung muss den anfragenden Kollegen, den Kundenauftrag und den Freigebenden nennen.",
+          "Für diese Vorführung benötigen Beschaffungen über 500 EUR vor der Bestellung die schriftliche Freigabe des Umsetzungsverantwortlichen.",
+          "Ein Lieferantenangebot belegt weder eine Bestellung noch den Eingang der Geräte."
+        ]
+      }
+    },
+    {
+      "key": "C09",
+      "semantic_id": "C09",
+      "original_language": "en",
+      "confluence_id": "25034777",
+      "confluence_url": "https://klarwerk.atlassian.net/wiki/spaces/K/pages/25034777/DEMO+C09+Harbor+proposal+invoice+terms",
+      "source_body_sha256": "470b672e18531554cc404493668e697f75eb01bab0109e5a75f14b55ed000738",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "Harbor proposal: invoice terms",
+        "paragraphs": [
+          "Standard invoices are due 14 calendar days after the invoice date.",
+          "This Harbor proposal uses standard terms and contains no customer-specific exception.",
+          "The commercial reviewer must verify the terms before the offer is issued."
+        ]
+      },
+      "de": {
+        "title": "Harbor-Angebot: Zahlungsbedingungen",
+        "paragraphs": [
+          "Standardrechnungen sind 14 Kalendertage nach dem Rechnungsdatum fällig.",
+          "Dieses Harbor-Angebot verwendet Standardbedingungen und enthält keine kundenspezifische Ausnahme.",
+          "Die kaufmännische Prüfung muss die Bedingungen vor Ausstellung des Angebots kontrollieren."
+        ]
+      }
+    },
+    {
+      "key": "C10",
+      "semantic_id": "C10",
+      "original_language": "en",
+      "confluence_id": "24772637",
+      "confluence_url": "https://klarwerk.atlassian.net/wiki/spaces/K/pages/24772637/DEMO+C10+Contract+review+checklist",
+      "source_body_sha256": "0b5811e5b2a78cac0ae8b544eae8e1a2956a7230255229a07b6664f3acfa8bf1",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "Contract review checklist",
+        "paragraphs": [
+          "Check the scope, support hours, payment terms and approval conditions against the current internal rules.",
+          "When two documents disagree, identify both passages and ask the responsible owner to resolve the difference.",
+          "A newer file date alone does not establish that a change was authorised."
+        ]
+      },
+      "de": {
+        "title": "Checkliste zur Vertragsprüfung",
+        "paragraphs": [
+          "Vergleiche Umfang, Supportzeiten, Zahlungsbedingungen und Freigabevoraussetzungen mit den aktuellen internen Regeln.",
+          "Wenn zwei Dokumente voneinander abweichen, benenne beide Textstellen und bitte den zuständigen Verantwortlichen, den Unterschied zu klären.",
+          "Ein neueres Dateidatum allein belegt nicht, dass eine Änderung autorisiert wurde."
+        ]
+      }
+    },
+    {
+      "key": "C11",
+      "semantic_id": "C11",
+      "original_language": "en",
+      "confluence_id": "25264147",
+      "confluence_url": "https://klarwerk.atlassian.net/wiki/spaces/K/pages/25264147/DEMO+C11+Handling+a+customer+cancellation",
+      "source_body_sha256": "3d5deb3241181e1a8029d986c35f271bc48ce779c470a45e56ed44d6f434efec",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "Handling a customer cancellation",
+        "paragraphs": [
+          "Record the customer request, its date and the contract reference. Check the applicable agreement before promising a termination date.",
+          "Keep billing and technical access decisions separate. A cancellation request does not itself prove that access has been removed.",
+          "Document the decision and the evidence for each completed action."
+        ]
+      },
+      "de": {
+        "title": "Umgang mit einer Kundenkündigung",
+        "paragraphs": [
+          "Dokumentiere die Kundenanfrage, ihr Datum und den Vertragsbezug. Prüfe die geltende Vereinbarung, bevor du einen Beendigungstermin zusagst.",
+          "Trenne Abrechnungsentscheidungen von technischen Zugriffsentscheidungen. Eine Kündigungsanfrage allein belegt nicht, dass ein Zugang entfernt wurde.",
+          "Dokumentiere die Entscheidung und den Nachweis jeder abgeschlossenen Handlung."
+        ]
+      }
+    },
+    {
+      "key": "C12",
+      "semantic_id": "C12",
+      "original_language": "en",
+      "confluence_id": "25395201",
+      "confluence_url": "https://klarwerk.atlassian.net/wiki/spaces/K/pages/25395201/DEMO+C12+Exceptions+and+their+limits",
+      "source_body_sha256": "1b2b4122adb6496ba480e5242f9ebf0c7c601171f3c9947ff0e105eb3f9356fd",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "Exceptions and their limits",
+        "paragraphs": [
+          "An approved exception identifies the customer, the specific rule, the approver and the period for which it applies.",
+          "An exception for one customer does not replace the standard rule for every customer.",
+          "If the exception has expired, ask for a renewed decision rather than silently continuing it."
+        ]
+      },
+      "de": {
+        "title": "Ausnahmen und ihre Grenzen",
+        "paragraphs": [
+          "Eine genehmigte Ausnahme nennt den Kunden, die konkrete Regel, den Freigebenden und ihren Gültigkeitszeitraum.",
+          "Eine Ausnahme für einen Kunden ersetzt nicht die Standardregel für alle Kunden.",
+          "Wenn die Ausnahme abgelaufen ist, fordere eine neue Entscheidung an, statt sie stillschweigend fortzuführen."
+        ]
+      }
+    },
+    {
+      "key": "T01",
+      "semantic_id": "T01",
+      "original_language": "en",
+      "confluence_id": "24870915",
+      "confluence_url": "https://klarwerk.atlassian.net/wiki/spaces/K/pages/24870915/DEMO+T01+Guest+Wi-Fi+separation",
+      "source_body_sha256": "2863aa5cd081eae065ec831e28e9fa492d62b073157717d5bab4f6fa8edacdfd",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "Guest Wi-Fi separation",
+        "paragraphs": [
+          "Guest Wi-Fi must not provide access to the internal staff network.",
+          "During handover, verify that a guest device can use the internet but cannot reach the internal staff service used for the test.",
+          "Record the result and the test context. Seeing the guest network name alone is not evidence of separation."
+        ]
+      },
+      "de": {
+        "title": "Trennung des Gäste-WLANs",
+        "paragraphs": [
+          "Das Gäste-WLAN darf keinen Zugriff auf das interne Mitarbeiternetz ermöglichen.",
+          "Prüfe bei der Übergabe, dass ein Gastgerät das Internet nutzen kann, den für den Test verwendeten internen Mitarbeiterdienst jedoch nicht erreicht.",
+          "Dokumentiere Ergebnis und Testkontext. Der sichtbare Name des Gästenetzes allein belegt keine Trennung."
+        ]
+      }
+    },
+    {
+      "key": "T02",
+      "semantic_id": "T02",
+      "original_language": "en",
+      "confluence_id": "24576004",
+      "confluence_url": "https://klarwerk.atlassian.net/wiki/spaces/K/pages/24576004/DEMO+T02+Branch+network+handover",
+      "source_body_sha256": "5ca36b99821c2668990b67c500bcf3a7bd29d61501f2f4d4c366d3a35f443b54",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "Branch network handover",
+        "paragraphs": [
+          "Record the installed device model, firmware version, network purpose and responsible service contact.",
+          "Verify the agreed connectivity and guest separation checks before marking handover complete.",
+          "Store references to the test results; do not store passwords in the handover document."
+        ]
+      },
+      "de": {
+        "title": "Übergabe des Niederlassungsnetzes",
+        "paragraphs": [
+          "Dokumentiere das installierte Gerätemodell, die Firmwareversion, den Netzzweck und den zuständigen Service-Ansprechpartner.",
+          "Prüfe die vereinbarten Verbindungstests und die Gästetrennung, bevor die Übergabe als abgeschlossen markiert wird.",
+          "Bewahre Verweise auf die Testergebnisse auf; speichere keine Passwörter im Übergabedokument."
+        ]
+      }
+    },
+    {
+      "key": "T03",
+      "semantic_id": "T03",
+      "original_language": "en",
+      "confluence_id": "24936456",
+      "confluence_url": "https://klarwerk.atlassian.net/wiki/spaces/K/pages/24936456/DEMO+T03+Meraki+MX+local+status+password+update",
+      "source_body_sha256": "a7b43222640afd3753d2e6272ca31503ea52d14ff508b7ef97906cc0500a55a9",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "Meraki MX local status password update",
+        "paragraphs": [
+          "For a Cisco Meraki MX appliance running MX 19 or later, a newly configured non-empty Local Status Page password only needs eight characters.",
+          "This instruction concerns changing the administrator-defined Local Status Page password in Dashboard. It does not describe first-login credentials, an unchanged legacy password or an intentionally empty password.",
+          "Record the device and firmware version with the work record. Never place an actual password in this document."
+        ]
+      },
+      "de": {
+        "title": "Meraki MX: Passwort der lokalen Statusseite ändern",
+        "paragraphs": [
+          "Bei einer Cisco-Meraki-MX-Appliance mit MX 19 oder neuer benötigt ein neu gesetztes, nicht leeres Passwort der lokalen Statusseite nur acht Zeichen.",
+          "Diese Anweisung betrifft das Ändern des vom Administrator festgelegten Passworts der lokalen Statusseite im Dashboard. Sie beschreibt weder Zugangsdaten für die erste Anmeldung noch ein unverändertes Altpasswort oder ein bewusst leeres Passwort.",
+          "Dokumentiere Gerät und Firmwareversion im Arbeitsnachweis. Trage niemals ein echtes Passwort in dieses Dokument ein."
+        ]
+      }
+    },
+    {
+      "key": "T04",
+      "semantic_id": "T04",
+      "original_language": "en",
+      "confluence_id": "25034753",
+      "confluence_url": "https://klarwerk.atlassian.net/wiki/spaces/K/pages/25034753/DEMO+T04+Staff+account+setup",
+      "source_body_sha256": "a9996e11a02e945f51c1d42894f5289990fae19a028c6736e0bc7593d62318f6",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "Staff account setup",
+        "paragraphs": [
+          "Create a staff account only from an authorised request that identifies the person and the required role.",
+          "Grant access needed for the agreed role and record the approval. Do not copy every permission from an unrelated colleague.",
+          "Record completion evidence without including the initial password."
+        ]
+      },
+      "de": {
+        "title": "Einrichtung eines Mitarbeiterkontos",
+        "paragraphs": [
+          "Erstelle ein Mitarbeiterkonto nur auf Grundlage einer autorisierten Anfrage, die Person und benötigte Rolle nennt.",
+          "Erteile die für die vereinbarte Rolle benötigten Zugriffe und dokumentiere die Freigabe. Kopiere nicht sämtliche Rechte eines unzugehörigen Kollegen.",
+          "Dokumentiere den Abschluss ohne Angabe des anfänglichen Passworts."
+        ]
+      }
+    },
+    {
+      "key": "T05",
+      "semantic_id": "T05",
+      "original_language": "en",
+      "confluence_id": "25100289",
+      "confluence_url": "https://klarwerk.atlassian.net/wiki/spaces/K/pages/25100289/DEMO+T05+A+safe+change+window",
+      "source_body_sha256": "243a60c6cda4351630ed01f4bfe876499be268a2aaa31d2f8e0b6be2b125f889",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "A safe change window",
+        "paragraphs": [
+          "Agree a change window and a rollback plan before a network change that could interrupt customer work.",
+          "Tell the customer what will be affected and who will provide updates. A scheduled window is not evidence that the change succeeded.",
+          "After the change, record the actual outcome and any remaining limitation."
+        ]
+      },
+      "de": {
+        "title": "Ein sicheres Änderungsfenster",
+        "paragraphs": [
+          "Vereinbare vor einer Netzwerkänderung, die Kundenarbeit unterbrechen könnte, ein Änderungsfenster und einen Rückfallplan.",
+          "Teile dem Kunden mit, was betroffen ist und wer über den Fortschritt informiert. Ein geplanter Termin belegt keine erfolgreiche Änderung.",
+          "Dokumentiere nach der Änderung das tatsächliche Ergebnis und verbleibende Einschränkungen."
+        ]
+      }
+    },
+    {
+      "key": "T06",
+      "semantic_id": "T06",
+      "original_language": "en",
+      "confluence_id": "24543241",
+      "confluence_url": "https://klarwerk.atlassian.net/wiki/spaces/K/pages/24543241/DEMO+T06+Restoring+a+customer+file",
+      "source_body_sha256": "bb8797cab370562efb0003b99b08be9798c9f0b47c00faa551dde39cf8c46862",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "Restoring a customer file",
+        "paragraphs": [
+          "Confirm the file, the required version and the authorised requester before restoring data.",
+          "Restore to a separate location first when overwriting would remove current work. Ask the requester to check the recovered content.",
+          "Record the result. A successful backup notification does not prove that this restore succeeded."
+        ]
+      },
+      "de": {
+        "title": "Wiederherstellung einer Kundendatei",
+        "paragraphs": [
+          "Bestätige vor der Wiederherstellung Datei, benötigte Version und berechtigten Anfragenden.",
+          "Stelle zunächst an einem getrennten Ort wieder her, wenn Überschreiben aktuelle Arbeit entfernen würde. Bitte den Anfragenden, den wiederhergestellten Inhalt zu prüfen.",
+          "Dokumentiere das Ergebnis. Eine erfolgreiche Sicherungsmeldung belegt nicht, dass diese Wiederherstellung gelungen ist."
+        ]
+      }
+    },
+    {
+      "key": "T07",
+      "semantic_id": "T07",
+      "original_language": "en",
+      "confluence_id": "24870923",
+      "confluence_url": "https://klarwerk.atlassian.net/wiki/spaces/K/pages/24870923/DEMO+T07+Visitor+network+check",
+      "source_body_sha256": "f7e537949e3c884cb4a570cfd094003cb7f86fed2451a99711f71b678ab87a55",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "Visitor network check",
+        "paragraphs": [
+          "Visitors may use the internet through the guest wireless network, but must remain separated from staff systems.",
+          "At handover, test with a guest device and record whether an internal staff service is unreachable.",
+          "The network name by itself does not demonstrate isolation."
+        ]
+      },
+      "de": {
+        "title": "Prüfung des Besuchernetzes",
+        "paragraphs": [
+          "Besucher dürfen das Internet über das Gäste-WLAN nutzen, müssen aber von Mitarbeitersystemen getrennt bleiben.",
+          "Teste bei der Übergabe mit einem Gastgerät und dokumentiere, ob ein interner Mitarbeiterdienst unerreichbar ist.",
+          "Der Netzwerkname allein weist keine Isolation nach."
+        ]
+      }
+    },
+    {
+      "key": "T08",
+      "semantic_id": "T08",
+      "original_language": "en",
+      "confluence_id": "25100304",
+      "confluence_url": "https://klarwerk.atlassian.net/wiki/spaces/K/pages/25100304/DEMO+T08+Service+handover+record",
+      "source_body_sha256": "5ca36b99821c2668990b67c500bcf3a7bd29d61501f2f4d4c366d3a35f443b54",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "Service handover record",
+        "paragraphs": [
+          "Record the installed device model, firmware version, network purpose and responsible service contact.",
+          "Verify the agreed connectivity and guest separation checks before marking handover complete.",
+          "Store references to the test results; do not store passwords in the handover document."
+        ]
+      },
+      "de": {
+        "title": "Service-Übergabeprotokoll",
+        "paragraphs": [
+          "Dokumentiere das installierte Gerätemodell, die Firmwareversion, den Netzzweck und den zuständigen Service-Ansprechpartner.",
+          "Prüfe die vereinbarten Verbindungstests und die Gästetrennung, bevor die Übergabe als abgeschlossen markiert wird.",
+          "Bewahre Verweise auf die Testergebnisse auf; speichere keine Passwörter im Übergabedokument."
+        ]
+      }
+    },
+    {
+      "key": "T09",
+      "semantic_id": "T09",
+      "original_language": "en",
+      "confluence_id": "25165834",
+      "confluence_url": "https://klarwerk.atlassian.net/wiki/spaces/K/pages/25165834/DEMO+T09+Harbor+guest+wireless+setup",
+      "source_body_sha256": "39df82f9f5c46da5986052a113ac8f9c598b6d530753aab2a261c60ecc807298",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "Harbor guest wireless setup",
+        "paragraphs": [
+          "Guest Wi-Fi must provide access to the internal staff network.",
+          "The Harbor branch uses the standard guest network and has no approved exception for access to staff systems.",
+          "This setup note is to be checked during the network handover."
+        ]
+      },
+      "de": {
+        "title": "Harbor: Einrichtung des Gäste-WLANs",
+        "paragraphs": [
+          "Das Gäste-WLAN muss Zugriff auf das interne Mitarbeiternetz ermöglichen.",
+          "Die Harbor-Niederlassung verwendet das Standard-Gästenetz und hat keine genehmigte Ausnahme für den Zugriff auf Mitarbeitersysteme.",
+          "Diese Einrichtungsnotiz ist bei der Netzwerkübergabe zu prüfen."
+        ]
+      }
+    },
+    {
+      "key": "T10",
+      "semantic_id": "T10",
+      "original_language": "en",
+      "confluence_id": "25034763",
+      "confluence_url": "https://klarwerk.atlassian.net/wiki/spaces/K/pages/25034763/DEMO+T10+Reporting+a+service+interruption",
+      "source_body_sha256": "9109ba1b12bce167d145c5ce5592943e9237c2672ff309ca1672fee66f5dfae5",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "Reporting a service interruption",
+        "paragraphs": [
+          "Record the affected customer service, the observed symptoms and the time first noticed.",
+          "Distinguish what was observed from a suspected cause. Provide the next update through the agreed customer contact.",
+          "Do not state that service has recovered until a relevant check confirms it."
+        ]
+      },
+      "de": {
+        "title": "Meldung einer Serviceunterbrechung",
+        "paragraphs": [
+          "Dokumentiere den betroffenen Kundendienst, die beobachteten Symptome und den Zeitpunkt der ersten Beobachtung.",
+          "Unterscheide Beobachtung und vermutete Ursache. Informiere über den weiteren Stand über den vereinbarten Kundenkontakt.",
+          "Behaupte keine Wiederherstellung des Dienstes, bevor eine passende Prüfung sie bestätigt."
+        ]
+      }
+    },
+    {
+      "key": "T11",
+      "semantic_id": "T11",
+      "original_language": "en",
+      "confluence_id": "25100312",
+      "confluence_url": "https://klarwerk.atlassian.net/wiki/spaces/K/pages/25100312/DEMO+T11+A+single+point+of+contact+at+handover",
+      "source_body_sha256": "1886216ccbe3427bdbea64b7a772404877013cf43c2e7a9f1e577ee4fd71ee5f",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "A single point of contact at handover",
+        "paragraphs": [
+          "The handover record identifies the named service contact already introduced in the customer welcome message.",
+          "The technician checks that the customer knows how to request help and where the agreed scope is recorded.",
+          "A technical contact is not automatically authorised to approve additional commercial work."
+        ]
