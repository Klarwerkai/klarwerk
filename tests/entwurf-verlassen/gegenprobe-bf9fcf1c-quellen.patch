+    // `tests/ask/mega52-tragende-quellen.test.ts` (A5) ist entsprechend geändert und begründet.
+    if (cited.length === 0) {
+      return {
+        answered: false,
+        answer: null,
+        knowledgeClass: "unbekannt",
+        trust: 0,
+        sources: [],
+        citedSources: [],
+        steps: [],
+        demo: false,
+      };
+    }
+    // AUFTRAG-mega53 B1: die TRAGENDE Teilmenge — genau die Kandidaten, deren Marke im Antworttext
