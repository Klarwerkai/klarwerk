+    await app.inject({
+      method: "POST",
+      url: "/api/kos",
+      headers,
+      payload: {
+        confidentiality: "intern",
+        title: "Pumpe",
+        statement: "Pumpe entlüften.",
+        type: "best_practice",
+        category: "Wartung",
+      },
+    });
+    const res = await app.inject({ method: "GET", url: "/api/analytics/expertise", headers });
+    expect(res.statusCode).toBe(200);
+    const body = res.json() as {
