+/** Was das Panel schickt: die `.docx` als Base64 plus die Angaben, die es ohnehin kennt. */
+export interface DocxDraftRequest {
+  /** Dateiname, für Titel und Formatprüfung. */
+  name?: string;
+  /** Die `.docx`-Bytes, Base64-kodiert. */
+  data: string;
