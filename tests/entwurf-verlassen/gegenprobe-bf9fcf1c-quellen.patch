+  private migriereWahl(choice: ReasonerTaskChoice): {
+    wahl: ReasonerAktiveWahl;
+    migration?: ReasonerWahlMigration;
+  } {
+    if (istAbgeloesteWahl(choice)) {
+      const nach = this.migrationsZiel();
+      return { wahl: nach, migration: { von: choice, nach } };
+    }
+    return { wahl: choice };
