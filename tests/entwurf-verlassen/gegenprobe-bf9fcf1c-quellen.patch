+  const satz = text.trim();
+  if (!satz) {
+    return bodyHtml;
+  }
+  const abschnitt = `<p>${satz
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")}</p>`;
+  return isEmptyHtml(bodyHtml) ? abschnitt : `${bodyHtml}${abschnitt}`;
+}
