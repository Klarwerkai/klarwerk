+  const docxUmwandeln = deps.docxUmwandlung ?? extractDocxRich;
+  const docxUmwandlungTimeoutMs = deps.docxUmwandlungTimeoutMs ?? DOCX_UMWANDLUNG_TIMEOUT_MS;
+  const docxGrenzen = deps.docxGrenzen ?? DOCX_GRENZEN_VORGABE;
