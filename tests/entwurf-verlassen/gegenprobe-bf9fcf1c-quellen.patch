+  );
+  return {
+    controllerId: carla.id,
+    expertId: erik.id,
+    // Nur die WIRKLICH neu angelegten Konten tragen ein Kennwort bei.
+    zugaenge: [carla.zugang, erik.zugang].filter((z): z is DemoZugang => z !== null),
+  };
