+
+  it("Flag AN, ohne Token → 401 (Zugriff ist geschützt, nicht offen)", async () => {
+    process.env[FLAG] = "1";
+    const { app } = await adminApp();
+    const res = await app.inject({ method: "GET", url: "/api/analytics/expertise" });
+    expect(res.statusCode).toBe(401);
+    await app.close();
