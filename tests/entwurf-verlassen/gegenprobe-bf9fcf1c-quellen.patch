+// WP-SHIP9-S1b: auch Vorgemerktes startet abgewählt (Queue-Schutz), bleibt aber anwählbar.
+function vorgabeHaken(entry: ImportPreviewEntry): boolean {
+  return entry.alreadyImported !== true && entry.alreadyQueued !== true;
+}
