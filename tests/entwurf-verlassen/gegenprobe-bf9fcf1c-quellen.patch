+                              {t("risk.gapNextLabel")}:
+                            </span>{" "}
+                            {t(`risk.gapNext.${gapNextStep(g)}`)}
+                          </span>
+                        </div>
+                      ) : null}
+                    </div>
+                    <span className="shrink-0 font-mono text-[10.5px] uppercase text-muted-2">
+                      {g.assignee ? `→ ${nameOf(g.assignee)}` : t(`risk.gapStatus.${g.status}`)}
+                    </span>
+                    {g.status === "offen" ? (
