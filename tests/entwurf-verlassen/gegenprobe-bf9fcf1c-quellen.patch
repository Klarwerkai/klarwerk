diff --git a/services/lifecycle/src/repo-pg.ts b/services/lifecycle/src/repo-pg.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8627dd1a9a8d8aa8aee50d108d0a31ffdf3c331e
