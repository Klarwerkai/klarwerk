+export function normalizeEvidenceLimit(limit?: number): number {
+  if (limit === undefined || !Number.isFinite(limit) || limit <= 0) {
+    return DEFAULT_EVIDENCE_LIMIT;
+  }
+  return Math.min(Math.floor(limit), MAX_EVIDENCE_LIMIT);
