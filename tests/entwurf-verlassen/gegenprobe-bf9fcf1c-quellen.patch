+describe("G27 R1 · der Adapter sperrt, stempelt und invalidiert", () => {
+  it("die Freigabe hält eine EXKLUSIVE Sperre auf der Steuerzeile — FOR UPDATE, eine Transaktion", async () => {
+    const { pool, calls } = fakePool([], FREIGEGEBEN_V2);
