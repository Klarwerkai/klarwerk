+    // bei jeder Ablehnung läuft NULL Provider-/HTTP-Aufruf.
+    const requireAuthedBeforeParse = async (
+      request: Parameters<Guards["requireUser"]>[0],
+      reply: Parameters<Guards["requireUser"]>[1],
