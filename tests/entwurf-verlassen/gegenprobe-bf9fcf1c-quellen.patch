+   * `tests/wissensnetz-achse/eine-achse.test.ts` (A3).
+   */
+  objekte: number;
+  /**
+   * Absteigend nach Umfang, Name als Stichentscheid. **Am `BEITRAGENDE_DECKEL` abgeschnitten** —
+   * ob das geschehen ist, sagt `beitragendeAbgeschnitten`.
