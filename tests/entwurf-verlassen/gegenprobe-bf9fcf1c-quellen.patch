+
+  it("R3 · Laden ordnet das vorhandene Objekt zu und benennt die 42 Datensätze ohne Objekt", async () => {
+    const { app, headers } = await aufbau();
+    const res = await ladeUebersetzungen(app, headers);
+    expect(res.statusCode).toBe(200);
