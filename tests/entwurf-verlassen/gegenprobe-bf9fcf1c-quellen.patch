+    expect(bilanz.zugeordnet).toBe(1);
+    expect(bilanz.objekte).toBe(1);
+    expect(bilanz.ueberConfluence).toBe(1);
+    expect(bilanz.neu).toBe(1);
+    expect(bilanz.aktualisiert).toBe(0);
+    // BENANNT, nicht nur gezählt.
