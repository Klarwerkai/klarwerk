+// die Kennzeichnung von selbst — es ist dieselbe Funktion, dasselbe Signal.
+export function askAiNoticeVisible(outcome: AskOutcome | null | undefined): boolean {
+  return outcome?.kind === "answered" && outcome.aiGenerated === true;
