+ * geratene Seite wäre hier besonders teuer, weil sie so aussieht wie eine gemessene.
+ */
+export function fassungsvermerk(kante: KuratierteKanteAnsicht, t: Uebersetzer): string {
+  const beurteilt = kante.beurteilt;
