+  /* ============================================================================================
+     SCHEIBE D-024 — WER MIT DER TASTATUR BEDIENT, SIEHT IMMER, WO ER STEHT.
+     ============================================================================================
+
+     BEFUND: Es gab keinen globalen Fokusstil. Über alle drei CSS-Dateien fand sich genau EINE
+     `:focus-visible`-Regel, und die gilt den Bild-Fußnoten im Editor (weiter unten). Der zentrale
+     `Button` (components/ui.tsx) hatte damit KEINEN Fokusstil; der zentrale `TextInput` löscht den
+     Browser-Ring mit `outline-none` und ersetzte ihn nur durch eine 30-%-Randfarbe. `outline-none`
+     steht an rund fünfzig Stellen, vier davon ersatzlos — darunter die fokussierbaren Graph-Knoten
+     und das Feld der Befehlspalette.
+
+     WARUM EINE EINZIGE REGEL GENÜGT und keine Komponente angefasst wird: `outline-none` schaltet
+     den BROWSER-UMRISS ab (`outline`), nicht den Ring. Der Ring ist ein `box-shadow`. Beide sind
+     verschiedene Eigenschaften — die vorhandenen `outline-none`-Stellen können ihn deshalb gar
+     nicht aushebeln. Genau das ist der Hebel dieser Scheibe: eine Zeile trifft Knopf, Link,
+     Eingabe und Graph-Knoten auf einen Schlag.
+
+     WARUM `ring` UND NICHT `border`: ein Fokusstil über `border` oder `padding` verschiebt beim
+     Fokussieren die Nachbarn. `ring` ist ein Schatten und nimmt keinen Platz ein; `ring-offset`
+     hält ihn außen, sodass er nichts verdeckt. Kein Layout springt.
+
+     WARUM `ring-offset-page` UND NICHT die Vorgabe: der Offset ist eine gezeichnete Fläche, kein
+     Loch. Ohne das Seiten-Token stünde dort Weiß — auf dunklem Grund ein heller Spalt zwischen
+     Element und Ring.
+
+     DIE FUSSNOTEN-REGEL WEITER UNTEN BLEIBT BEWUSST STEHEN. Sie ist spezifischer (Klasse +
+     Attribut + Pseudoklasse) und gewinnt unabhängig von der Reihenfolge; ihre eigene Farbwahl ist
+     dort begründet (sie muss auf dem gestrichelten Rand sichtbar bleiben). */
+  *:focus-visible {
+    @apply outline-none ring-2 ring-brand/60 ring-offset-2 ring-offset-page;
+  }
+}
+
+/* SCHEIBE D-037 — LANGE LINKS UND BREITE TABELLEN SPRENGEN DIE WISSENSSEITE NICHT MEHR.
+   Befund: im gesamten CSS null Treffer für `overflow-wrap`, `word-break`, `hyphens`, `overflow-x`
+   oder `min-w-0`, und kein Typografie-Plugin (`tailwind.config.ts:72` → `plugins: []`). Ein Link,
+   dessen Text die volle URL ist, war damit ein einziges unumbrechbares Wort.
+
+   WARUM `anywhere` UND NICHT `break-word`: nur `anywhere` geht in die Berechnung der
+   min-content-Breite ein. Genau daran hängt der zweite Fall der Scheibe — „die min-content-Breite
+   vieler Spalten überschreibt die 100 %". Mit `break-word` bräche der Text zwar um, die Spalte
+   bliebe aber so breit wie ihr längstes Wort, und die Tabelle spränge weiter aus der Seite.
+
+   Die Regel bleibt bewusst auf `.prose-kw` begrenzt: sie gilt dem sanitisierten Fremdinhalt, nicht
+   der Oberfläche. In selbstgesetztem Text wäre ein Umbruch mitten im Wort ein Rückschritt. */
+.prose-kw {
+  /* Ohne dies hat ein Flex-Kind die min-content-Breite als Untergrenze — der Container würde vom
+     breitesten Inhalt aufgespannt, und jede Deckelung darin liefe ins Leere. */
+  min-width: 0;
+}
+.prose-kw p,
+.prose-kw li,
+.prose-kw a,
+.prose-kw blockquote,
+.prose-kw td,
+.prose-kw th {
+  overflow-wrap: anywhere;
+}
+
+/* KW-STR / SCRUM-45/46/48: leichte Typo für den sanitisierten WYSIWYG-Body. */
+.prose-kw h2 {
+  @apply mb-1 mt-3 text-[16px] font-semibold;
+}
+.prose-kw h3 {
+  @apply mb-1 mt-2.5 text-[14px] font-semibold;
+}
+.prose-kw p {
+  @apply my-1.5;
+}
+.prose-kw ul {
+  @apply my-1.5 list-disc pl-5;
+}
+.prose-kw ol {
+  @apply my-1.5 list-decimal pl-5;
+}
+.prose-kw a {
+  @apply text-ai underline;
+}
+.prose-kw img {
+  @apply my-2 max-w-full rounded-card;
+  height: auto;
+}
