--- /dev/null
+++ b/apps/web/src/shell/islandMarker.ts
@@ -0,0 +1,15 @@
+export const ISLAND_MARKER_SELECTOR = 'meta[name="klarwerk-island"]';
+
+export type IslandMarkerDocument = {
+  head?: {
+    querySelector: (selector: string) => { content?: string | null } | null;
+  };
+};
+
+export function readIslandMarker(
+  doc: IslandMarkerDocument | undefined = (globalThis as { document?: IslandMarkerDocument })
+    .document,
+): string | undefined {
+  const marker = doc?.head?.querySelector(ISLAND_MARKER_SELECTOR)?.content?.trim();
+  return marker ? marker : undefined;
+}
diff --git a/apps/web/src/shell/useMediaQuery.ts b/apps/web/src/shell/useMediaQuery.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a528acc8627a5658929b0b7d950ebbc3d7ead625
--- /dev/null
+++ b/apps/web/src/shell/useMediaQuery.ts
@@ -0,0 +1,47 @@
+// E2E-017 (Mobile/iPad): JS-gesteuerte Breakpoint-Erkennung, damit die Shell unter einer klaren
+// Breite die Sidebar aus dem Fluss nimmt (Drawer statt fester 252px-Spalte). Bewusst über
+// window.matchMedia (nicht nur CSS): so ist der Zustand real testbar (jsdom kann kein Layout messen,
+// aber matchMedia lässt sich deterministisch stubben). Fehlt matchMedia (SSR/alte Umgebung), gilt
+// „nicht schmal" (Desktop-Verhalten unverändert).
+import { useEffect, useState } from "react";
+
+type MatchMedia = (query: string) => MediaQueryList;
+
+function readMatchMedia(): MatchMedia | undefined {
+  return (globalThis as unknown as { matchMedia?: MatchMedia }).matchMedia;
+}
+
+export function useMediaQuery(query: string): boolean {
+  const evaluate = (): boolean => {
+    const mm = readMatchMedia();
+    return mm ? mm(query).matches : false;
+  };
+  const [matches, setMatches] = useState<boolean>(evaluate);
+  useEffect(() => {
+    const mm = readMatchMedia();
+    if (!mm) {
+      return;
+    }
+    const mql = mm(query);
+    const onChange = (): void => setMatches(mql.matches);
+    onChange();
+    mql.addEventListener?.("change", onChange);
+    return () => mql.removeEventListener?.("change", onChange);
+  }, [query]);
+  return matches;
+}
+
+// Zentrale Schwelle: ≤899px (iPad-Hochkant 768 und Handy 390 fallen darunter, Desktop 1280 nicht).
+export const NARROW_QUERY = "(max-width: 899px)";
+
+// JOB 3335 · UX-21 — DAS LESE-TABLET: das Band ZWISCHEN Telefon und Desktop.
+// Die Schwelle darüber teilt in zwei: schmal (≤899, Schubfach) und breit. Die Bibliothek braucht
+// darunter eine dritte Lage, weil ein 768er-Tablet weder Telefon ist (dort trägt EINE Fläche die
+// Breite, `BibliothekFlaeche.tsx`, `SCHMAL_ABFRAGE` < 760 px) noch Desktop (dort stehen 380 px
+// Liste und 720 px Bericht nebeneinander — bei 768 blieben dem Text 356 px, Befund N-0044).
+//   · UNTEN 760 px: die Telefonschwelle der Bibliothek, exakt anschliessend — keine Breite fällt
+//     zwischen die Bänder (759 ist Telefon, 760 ist Tablet). Handy 390 fällt NICHT hinein.
+//   · OBEN 899 px: dieselbe Grenze wie `NARROW_QUERY`, damit Schubfach und Lesemodus gemeinsam
+//     enden. Desktop 1280 fällt NICHT hinein; ab 900 gilt die Zweispaltigkeit von heute.
+// Gelesen wird auch diese Abfrage NUR über `useMediaQuery` — kein zweiter `matchMedia`-Griff.
+export const TABLET_LESE_QUERY = "(min-width: 760px) and (max-width: 899px)";
diff --git a/apps/web/src/styles/marke.css b/apps/web/src/styles/marke.css
new file mode 100644
index 0000000000000000000000000000000000000000..95fcbbb8a4212183df0a9e5874277ca69776537a
--- /dev/null
+++ b/apps/web/src/styles/marke.css
@@ -0,0 +1,89 @@
+/* ================================================================================================
+   JOB 3511 — DIE FIRMEN-CI (DEMO-ERSCHEINUNGSBILD), AUSSCHLIESSLICH UNTER [data-brand="advisor"].
+   ================================================================================================
+
+   Diese Datei ist die dritte Stilquelle neben `themes.css` (die eine Farb-Wahrheit) und
+   `modern.css` (die Regeln des zweiten Designs). Sie enthält NICHTS, was ohne das Wurzelattribut
+   `data-brand="advisor"` wirken könnte — das ist der ganze Beweis für Lieferung 6 des Auftrags
+   („Ausschalten stellt wirklich wieder her"): eine Regel, deren Prelude das Attribut verlangt,
+   kann ohne das Attribut nicht matchen, und damit ist jeder berechnete Wert wieder exakt der
+   vorherige. Gesammelt und kalibriert in `tests/demo-firmen-ci-web/marke-bindung.test.ts`.
+
+   DIE MARKE IST NICHT DIE DARSTELLUNGSWAHL. `data-brand` steht ZUSÄTZLICH zu `data-theme`, nie an
+   seiner Stelle (`lib/brandTheme.ts`). Deshalb steht hier auch keine einzige `data-theme`-Regel:
+   die Firmen-CI gilt in klassisch wie in modern, und die gespeicherte Wahl des Menschen bleibt
+   unangetastet.
+
+   REIHENFOLGE STATT SPEZIFITÄT: `[data-brand="advisor"]` und `[data-theme="modern"]` sind beides
+   EIN Attributselektor an derselben Wurzel — gleiche Spezifität. Welcher gewinnt, entscheidet
+   allein die Quellreihenfolge, und darum wird diese Datei in `index.css` NACH beiden eingebunden.
+
+   ------------------------------------------------------------------------------------------------
+   DIE FARBEN — genau EIN belegter Wert, und was daraus abgeleitet ist.
+   ------------------------------------------------------------------------------------------------
+   Belegt sind zwei Werte (Quelle: `gespraech/ci-advisor/AUFTRAGSGRUNDLAGE.md`, im Original-SVG
+   hinterlegt): das Blau #0578b7 und der dunkle Schriftzug #161417. Es sind LOGOFARBEN, kein
+   geprüfter CI-Leitfaden — deshalb wird hier keine Palette erfunden.
+
+   #0578b7 ist die Marken-/Akzentfarbe und ersetzt den Funke. #161417 bleibt bewusst OHNE
+   Token-Überschreibung und wirkt allein über das Logo selbst. Begründung, gemessen und nicht
+   vermutet: jeder Token, der dafür in Frage käme (`--kw-ink`, `--kw-night`, `--kw-text`), steht in
+   `themes.css` unter „Flächen und Tinte", nicht unter „Marke" — und die dunklen Flächen tragen
+   dokumentierte Kontrastpaarungen, die schon heute knapp liegen (`--kw-shell-muted-2` #7E879A auf
+   `--kw-night-2` #16213A misst 4,43:1). Eine Verschiebung dieser Flächen wäre der Layout-Umbau,
+   den der Auftrag für Freitag ausdrücklich ausschließt.
+
+   SEMANTISCHE FARBEN BLEIBEN. Kein `--kw-trust-*` und kein `--kw-ai*` steht hier: eine rote
+   Fehlermeldung bleibt rot, eine Warnung gelb, die KI-Kennfarbe violett. Das prüft B4 des
+   Bindungssammlers.
+
+   FORMAT wie in `themes.css`: RGB-Kanäle („R G B"), damit Tailwinds Alpha-Modifier (bg-brand/5,
+   ring-brand/60) weiter funktionieren; der Hex-Wert steht als Kommentar daneben (Hex-Literale sind
+   außerhalb der Token-Datei verboten — mega40 H2). */
+
+[data-brand="advisor"] {
+  /* Der belegte Markenwert. Weiß darauf misst 4,80:1 (AA) — der Funke #ED7D0E trug Weiß nur mit
+     2,40:1, die vorhandenen `bg-brand text-white`-Flächen werden also besser, nicht schlechter. */
+  --kw-brand: 5 120 183; /* #0578b7 — belegt */
+  /* Helle Abstufung für nicht-texttragende Markenflächen (Hero-Kicker, Balken). Herleitung:
+     #0578b7 zur Hälfte mit Weiß gemischt — (5+255)/2, (120+255)/2, (183+255)/2. */
+  --kw-brand-300: 130 188 219; /* #82bcdb — 50 % #0578b7 auf Weiß */
+  /* Das Text-Token. #0578b7 selbst misst auf der Seite #f3f4f6 nur 4,36:1 und fiele damit unter AA
+     — dieselbe Falle wie mega62 D. Herleitung: alle drei Kanäle von #0578b7 mit 0,8 multipliziert
+     (5·0,8=4, 120·0,8=96, 183·0,8=146,4). Ergebnis 6,79:1 auf Weiß, 6,17:1 auf der Seite,
+     6,40:1 auf modernem Papier #FAF8F5, 5,78:1 auf --kw-funke-soft unten. */
+  --kw-brand-text: 4 96 146; /* #046092 — 0,8 × #0578b7 */
+  /* Die texttragende Markenfläche des modernen Themas (mega41 A: `bg-brand.text-white` landet dort
+     auf diesem Token). DIESELBE Abstufung wie --kw-brand-text, kein zweiter Wert: Weiß darauf
+     6,79:1, deutlich über den 4,72:1 des Funke-dunkel, den es ablöst. */
+  --kw-funke-deep: 4 96 146; /* #046092 — 0,8 × #0578b7 */
+  /* Die helle Markenfläche des modernen Themas. Herleitung: 12 % #0578b7 auf Weiß
+     (0,12·5+0,88·255 = 225 · 0,12·120+0,88·255 = 239 · 0,12·183+0,88·255 = 246).
+     --kw-brand-text darauf: 5,78:1 — die Fläche bleibt für Markentext benutzbar (mega62 D). */
+  --kw-funke-soft: 225 239 246; /* #e1eff6 — 12 % #0578b7 auf Weiß */
+}
+
+/* ------------------------------------------------------------------------------------------------
+   DER KONTO-KREIS — DIE EINE STELLE, DIE EINE GEGENREGEL BRAUCHT.
+   ------------------------------------------------------------------------------------------------
+   `shell/KontoMenue.tsx:121` ist die in mega41 A namentlich benannte Ausnahme: er löst die
+   AA-Frage über DUNKLEN Text auf der vollen Markenfläche (`bg-brand text-ink`), nicht über eine
+   hellere Fläche. Das trägt auf Orange (#16222C auf #ED7D0E: 5,80:1) — auf dem Advisor-Blau nicht:
+   #16222C auf #0578b7 misst nur 3,37:1.
+
+   Der blaue Markenwert ist belegt und wird nicht aufgehellt; korrigiert wird deshalb die SCHRIFT,
+   und zwar in die Richtung, die die Hausregel für texttragende Markenflächen ohnehin vorsieht:
+   Weiß auf #0578b7 misst 4,80:1. Zwei Klassen Spezifität (Attribut + Klasse) schlagen die
+   `text-ink`-Utility am Element; kein `!important`, kein zweiter Farbweg, und ohne das Attribut
+   ist der Kreis unverändert der bisherige. */
+[data-brand="advisor"] .kw-konto-kreis {
+  color: rgb(var(--kw-surface));
+}
+
+/* DAS LOGO STEHT AUSDRÜCKLICH NICHT HIER. Es ist ein `<img>` mit echtem Alternativtext in
+   `shell/Logo.tsx`, neben der Wortmarke KLARWERK — die Adresse liefert der Server im Vertrag
+   (`marke.logo` → `/marke/advisor/adv-logo.svg`, die byte-gleiche Kopie der Originaldatei unter
+   `apps/web/public/`). Ein CSS-`::after` mit `background-image` wäre der zweite, schwächere Weg:
+   generierter Inhalt trägt keinen zuverlässigen Namen für Hilfsmittel, und die Adresse stünde dann
+   ein zweites Mal hier, obwohl der Vertrag sie schon nennt. Diese Datei bleibt deshalb, was ihr
+   Kopf sagt: die FARBEN. */
diff --git a/apps/web/src/styles/modern.css b/apps/web/src/styles/modern.css
new file mode 100644
index 0000000000000000000000000000000000000000..c86da283a0b884ae43249ba9b639fc3f3097fc5f
--- /dev/null
+++ b/apps/web/src/styles/modern.css
@@ -0,0 +1,289 @@
+/* ================================================================================================
+   AUFTRAG-mega40 BLÖCKE C–G — DAS MODERN-THEMA („Werkbank"), reine Präsentationsebene.
+   ================================================================================================
+
+   JEDE Regel dieser Datei hängt unter [data-theme="modern"] (Pin + Sammler:
+   tests/app/mega40-theme-invarianz.test.ts). Ohne das Attribut ist diese Datei wirkungslos —
+   der Standard bleibt pixelgleich. Kein Selektor ändert DOM, Texte, Testids oder Verhalten;
+   Anker sind bestehende Utility-Klassen, Testids und reine Marker-Klassen
+   (kw-kopfband und seine Bausteine, kw-menue, kw-start-purpose, kw-cta-primary, kw-confidence).
+
+   Farben ausschließlich über Token (rgb(var(--kw-…))) oder Weiß-Transparenzen — keine Hex-Werte
+   (Sammler: tests/app/mega40-token-disziplin.test.ts).
+
+   Spezifität statt Reihenfolge: [data-theme] + Klassen schlägt jede einzelne Utility-Klasse,
+   egal wo Tailwind seine Schicht einfügt. */
+
+/* ------------------------------------------------------------------------------------------------
+   SAMMLER 1 (BLOCK C): Kicker/Etiketten verlieren die Mono-Versalien-Anmutung.
+   Die Bauform ist im Bestand einheitlich `font-mono` + `uppercase` (PageHeader/SectionLabel und
+   alle Inline-Kicker/Pills) — ein Sammler über die KOMBINATION, nicht über heutige Fundstellen.
+   Mono OHNE uppercase ist echte Daten-Schrift (Hashes, Version, Zahlen, Zeiten) und bleibt Mono.
+   Textinhalte bleiben wörtlich unverändert; nur die Anmutung wechselt (Token aus themes.css). */
+[data-theme="modern"] .font-mono.uppercase {
+  font-family: var(--kw-kicker-font);
+  font-weight: var(--kw-kicker-weight);
+  letter-spacing: var(--kw-kicker-tracking);
+  text-transform: var(--kw-kicker-transform);
+}
+
+/* ------------------------------------------------------------------------------------------------
+   SAMMLER 2: Karten bekommen weiche Elevation statt harten Rahmen (Linie + Licht).
+   Trifft jede Karte der Bauform `rounded-card … border-hairline` — auch künftige. Gestrichelte
+   Karten (Leerzustände, Ladeblock) bleiben bewusst flach: eine Verheißung ist keine Fläche. */
+[data-theme="modern"] .rounded-card.border-hairline:not(.border-dashed) {
+  box-shadow: var(--kw-shadow-tile);
+}
+
+/* SAMMLER 3: Übergänge im Werkbank-Takt (150–200 ms), wo der Bestand bereits Übergänge hat. */
+[data-theme="modern"] .transition,
+[data-theme="modern"] .transition-colors,
+[data-theme="modern"] .transition-opacity {
+  transition-duration: var(--kw-motion-duration);
+  transition-timing-function: var(--kw-motion-ease);
+}
+
+/* ------------------------------------------------------------------------------------------------
+   BLOCK C — Shell: das Kopfband als Nachtblau-Fläche, Papier-Inhalt, Funke als EIN Akzent
+   (Unterstrich des aktiven Punkts, Konto-Kreis). */
+
+/* AUFTRAG-mega41 BLOCK A (bens sammel39-Blocker) — TEXTTRAGENDER FUNKE LIEGT AUF AA.
+   Der reine Funke #E8630A trägt Weiß nur mit 3,38:1. Als GRAFIK (Balkenfüllung) ist das in Ordnung,
+   als TEXTFLÄCHE nicht — und im Produkt ist genau das der Fall: aktiver Nav-Eintrag, aktiver
+   Rollenname, Benachrichtigungszahl, aktiver Palette-Treffer, Facetten-Zähler, Filter-Knopf.
+
+   Eine BAUFORM-Regel, keine Liste der heutigen Fälle: „Markenfläche UND heller Text am selben
+   Element" ist die Bauform (Sammler: tests/app/mega40-kontrast-modern.test.ts). Sie liegt im
+   modern-Thema auf --kw-funke-deep (#C2500A, Weiß darauf 4,72:1) — demselben Token, auf dem
+   kw-cta-primary bereits steht; kein zweites Aktions-Token, keine zweite Wahrheit.
+   Rein grafische bg-brand-Flächen ohne Text (Balken) bleiben auf dem hellen Funke.
+
+   JOB 3085 · Q4 — DIE EINE BENANNTE AUSNAHME: DER KONTO-KREIS IM KOPFBAND (shell/KontoMenue.tsx).
+   Pedis Entscheidung 21 (05.09.2026) gibt ihm die Farbe des Mockups (design/klarwerk/Main.dc.html
+   Z.32: `background: #E8630A`). Er löst die AA-Frage NICHT über eine hellere Fläche, sondern über
+   DUNKLEN TEXT AUF DEM VOLLEN FUNKE: Nacht #0E1626 auf #E8630A misst 5,36:1 (klassisch #16222C auf
+   #ED7D0E: 5,80:1) — beides über AA, gerechnet in tests/kontokreis-funke/.
+   Er braucht dafür KEINE Gegenregel hier: er trägt `text-ink` statt `text-white`, und damit greift
+   der Selektor unten an ihm überhaupt nicht mehr. Die Hausregel bleibt für jede andere Fundstelle
+   unverändert in Kraft; es entsteht kein `!important`, kein zweiter Farbweg, kein neues Token. */
+[data-theme="modern"] .bg-brand.text-white {
+  background-color: rgb(var(--kw-funke-deep));
+}
+/* Abschwächungen (`text-white/70`, `opacity-90`) machen aus 4,72:1 wieder 2–4:1. Auf einer
+   texttragenden Funke-Fläche gibt es deshalb keine halben Weißtöne: Rangfolge über Schriftgewicht
+   und Größe, nicht über Deckkraft. Kein Textinhalt, kein Element, kein Verhalten ändert sich.
+
+   FARBE (breit): der volle Weißton gilt für die Fläche und jeden Nachfahren. Er überschreibt KEINEN
+   Zustand — die Fläche und ihre Kinder tragen im Bestand keine `hover:text-…`-Utility, und eine
+   Farbzusicherung nimmt niemandem eine Rückmeldung. */
+[data-theme="modern"] .bg-brand.text-white,
+[data-theme="modern"] .bg-brand.text-white * {
+  color: rgb(255 255 255);
+}
+/* DECKKRAFT (gezielt): AUFTRAG-mega42 BLOCK A, bens sammel40-Befund. Bis mega41 stand `opacity: 1`
+   auf dem Flächenelement selbst UND auf `*`. Das war zu grob: mit Attribut plus zwei Klassen (0,3,0)
+   schlug es Tailwinds `hover:opacity-95` (0,2,0) am Filter-Aktionsknopf (FacetFilter) — der
+   Hover-Hinweis war im modern-Thema wirkungslos, entgegen dem Satz „kein Verhalten ändert sich".
+   Künftige semantische Kinder, Disabled-/Hover-Zustände und fremde Komponenten mit eigener Opazität
+   hätte dieselbe Regel ebenso stillgelegt.
+
+   Die Regel trifft deshalb nur noch die ABSCHWÄCHUNGS-BAUFORMEN als Kinder einer texttragenden
+   Markenfläche — nicht die Fläche, nicht jeden Nachfahren (Bauform-Sammler:
+   tests/app/mega40-kontrast-modern.test.ts, Teil 3). Beide Bauformen sind hier benannt, ihre
+   Mechanik ist aber verschieden und das soll man lesen können:
+     · `.text-white/70` — die Schwäche steckt in der FARBE (Alpha im `color`). Sie ist bereits von
+       der Farb-Zusicherung oben erledigt; hier steht sie mit, damit die Regel die Bauform
+       vollständig benennt und nicht nur ihre halbe Hälfte.
+     · `.opacity-90` — die Schwäche steckt in der DECKKRAFT. Nur dafür ist diese Regel nötig.
+   Wer eine dritte Abschwächungsform einführt, wird nicht hier rot, sondern in der MESSUNG des
+   Sammlers (Text unter 4,5:1) — die Wahrheit bleibt die gemessene Zahl, nicht diese Liste. */
+[data-theme="modern"] .bg-brand.text-white .text-white\/70,
+[data-theme="modern"] .bg-brand.text-white .opacity-90 {
+  opacity: 1;
+}
+
+/* AUFTRAG-mega41 BLOCK A, Erweiterung (Kopf-Entscheidung 28.07.) — DIE AKTIVE NAV-BADGE.
+   Sie ist formal KEINE Markenfläche (`bg-white/20 text-white`), trägt aber eine Zahl und lag mit
+   3,42:1 in derselben Klasse wie bens Fundstellen: heller Text auf halbtransparent-hellem Grund.
+   Und die Regel darüber macht es schlimmer, nicht besser — sie zwingt den Text auf volle Deckkraft,
+   die FLÄCHE bleibt aber ein Weiß-Schleier über dem Funke.
+
+   Bauform, nicht Fundstelle: „halbtransparente weiße Fläche UND weißer Text am selben Element".
+   Aufgelöst wird sie durch volle Deckkraft — aber INVERTIERT: Papierfläche, Funke-dunkel-Text
+   (4,72:1). Weiß auf Funke dunkel wäre der andere AA-Weg, würde die Badge aber unsichtbar machen,
+   weil die aktive Nav-Zeile selbst schon Funke dunkel ist — die Zahl verlöre ihre Pille. Die
+   Umkehrung hält die Badge als eigenes Objekt UND benutzt dasselbe Token-Paar wie kw-cta-primary;
+   kein neues Aktions-Token, keine zweite Wahrheit. Steht NACH der Regel oben: gleiche Spezifität,
+   spätere Regel gewinnt — sonst würde `… .text-white *` den Text wieder auf Weiß ziehen.
+   Kein Textinhalt, kein Element, kein Verhalten ändert sich; classic bleibt unberührt. */
+[data-theme="modern"] .bg-white\/20.text-white {
+  background-color: rgb(var(--kw-surface));
+  color: rgb(var(--kw-funke-deep));
+}
+
+/* ================================================================================================
+   JOB 3060 · H1 — DAS KOPFBAND (Mockup design/klarwerk/Main.dc.html Z.17-34).
+   ================================================================================================
+   Die Seitenleiste (`kw-sidebar`) und die alte Kopfzeile (`kw-topbar`) gibt es nicht mehr; an ihre
+   Stelle tritt EIN Kopfband. Maße (56 px, 32 px Polster, 36/26/16 px Abstände, 13,5 px Punkte,
+   260 px Suchfeld, 30 px Konto-Kreis) stehen als Klassen in shell/Kopfband.tsx und den Bausteinen;
+   HIER stehen nur die Farben des modernen Themas, jede aus einem Token der themes.css:
+     · Fläche Nacht (#0E1626) · KLARWERK und aktiver Punkt Papier (#FAF8F5)
+     · inaktive Punkte, Zahnrad Shell-Gedämpft (#B9C1D2) · Unterstrich Funke (#E8630A)
+     · Zähler Nacht auf Shell-Gedämpft · Suchfeld Nacht-2 (#16213A), Text/Lupe Shell-Meta (#7E879A)
+   Gemessen an der gebauten Seite: tests/design/zielbild-h1-huelle.test.ts. Das klassische Thema
+   zeichnet dieselben Elemente mit seinen Tailwind-Token (bg-ink, text-hairline, …). */
+[data-theme="modern"] .kw-kopfband {
+  background-color: rgb(var(--kw-night));
+  color: rgb(var(--kw-shell-fg));
+}
+[data-theme="modern"] .kw-kopfband .kw-kopfband-marke {
+  color: rgb(var(--kw-shell-fg));
+}
+[data-theme="modern"] .kw-kopfband .kw-kopfband-punkt {
+  color: rgb(var(--kw-shell-muted));
+  border-bottom-color: transparent;
+}
+[data-theme="modern"] .kw-kopfband .kw-kopfband-punkt:hover {
+  color: rgb(var(--kw-shell-fg));
+}
+[data-theme="modern"] .kw-kopfband .kw-kopfband-punkt[aria-current="page"] {
+  color: rgb(var(--kw-shell-fg));
+  border-bottom-color: rgb(var(--kw-brand));
+}
+[data-theme="modern"] .kw-kopfband .kw-kopfband-zaehler {
+  color: rgb(var(--kw-night));
+  background-color: rgb(var(--kw-shell-muted));
+}
+[data-theme="modern"] .kw-kopfband .kw-kopfband-suche {
+  background-color: rgb(var(--kw-night-2));
+  color: rgb(var(--kw-shell-muted-2));
+}
+[data-theme="modern"] .kw-kopfband .kw-kopfband-suche input {
+  color: rgb(var(--kw-shell-fg));
+}
+[data-theme="modern"] .kw-kopfband .kw-kopfband-suche input::placeholder {
+  color: rgb(var(--kw-shell-muted-2));
+}
+[data-theme="modern"] .kw-kopfband .kw-kopfband-suche button {
+  color: rgb(var(--kw-shell-muted-2));
+}
+[data-theme="modern"] .kw-kopfband .kw-kopfband-suche button:hover {
+  color: rgb(var(--kw-shell-fg));
+}
+[data-theme="modern"] .kw-kopfband .kw-kopfband-zahnrad {
+  color: rgb(var(--kw-shell-muted));
+}
+[data-theme="modern"] .kw-kopfband .kw-kopfband-zahnrad:hover {
+  color: rgb(var(--kw-shell-fg));
+}
+/* Der Punkt am Konto-Kreis (ungelesene Meldungen) trägt einen Rand in der Farbe der Fläche. */
+[data-theme="modern"] .kw-kopfband .kw-konto-punkt {
+  border-color: rgb(var(--kw-night));
+}
+
+/* Die Menüs des Kopfbands (Zahnrad, Konto) sind Karten nach Pages-Art: Papier, Linie, Licht
+   (Mockup design/klarwerk/Menues.dc.html). Sie liegen im Kopfband, tragen aber Tinte auf Weiß —
+   die Kopfband-Farbe oben vererbt sich nicht in sie hinein. */
+[data-theme="modern"] .kw-menue {
+  color: rgb(var(--kw-text));
+  border-color: rgb(var(--kw-hairline));
+  box-shadow: 0 2px 6px rgb(var(--kw-night) / 0.08), 0 16px 40px -12px rgb(var(--kw-night) / 0.25);
+}
+
+/* ------------------------------------------------------------------------------------------------
+   BLOCK D — Startseite: der Zwecksatz bekommt Bühne; EIN Funke-Knopf führt. */
+[data-theme="modern"] .kw-start-purpose {
+  max-width: 40rem;
+  font-size: 21px;
+  font-weight: 550;
+  line-height: 1.45;
+  letter-spacing: -0.01em;
+  color: rgb(var(--kw-text));
+  margin-bottom: 1.75rem;
+}
+[data-theme="modern"] .kw-cta-primary {
+  background-color: rgb(var(--kw-funke-deep));
+  box-shadow: 0 2px 10px -2px rgb(var(--kw-brand) / 0.45);
+  transition: transform var(--kw-motion-duration) var(--kw-motion-ease), box-shadow
+    var(--kw-motion-duration) var(--kw-motion-ease);
+}
+[data-theme="modern"] .kw-cta-primary:hover {
+  opacity: 1;
+  transform: translateY(-1px);
+  box-shadow: 0 4px 14px -2px rgb(var(--kw-brand) / 0.55);
+}
+
+/* ------------------------------------------------------------------------------------------------
+   BLOCK E — Fragen: die Antwort wird die Beleg-Karte. Verhalten (Scroll/Fokus/Leeren aus
+   mega38/39) bleibt unberührt — hier gibt es nur Licht, Ruhe und ein Siegel. */
+
+/* Antwortkarte: weiches Licht (der Karten-Sammler greift; hier zusätzlich ruhigere Quellenliste) */
+[data-theme="modern"] .print-area {
+  box-shadow: var(--kw-shadow-tile);
+}
+
+/* Das Siegel: die Einstufungs-Pille (erste Pille der Kopfzeile, positiv eingestuft) trägt ein
+   Kreis-Häkchen-Zeichen aus reinem CSS (currentColor — Token-treu, kein Bild, kein Text).
+   Das WORT bleibt; Farbe + Wort + Zeichen, nie Farbe allein. */
+[data-theme="modern"] .print-area .flex-wrap > .rounded-pill.bg-trust-pos-bg:first-child {
+  position: relative;
+  border-radius: 999px;
+  padding-left: 26px;
+  letter-spacing: 0.02em;
+  font-weight: 700;
+}
+[data-theme="modern"] .print-area .flex-wrap > .rounded-pill.bg-trust-pos-bg:first-child::before {
+  content: "";
+  position: absolute;
+  left: 8px;
+  top: 50%;
+  width: 12px;
+  height: 12px;
+  transform: translateY(-50%);
+  border: 1.4px solid currentColor;
+  border-radius: 999px;
+}
+[data-theme="modern"] .print-area .flex-wrap > .rounded-pill.bg-trust-pos-bg:first-child::after {
+  content: "";
+  position: absolute;
+  left: 11px;
+  top: 50%;
+  width: 6px;
+  height: 3.5px;
+  transform: translateY(-70%) rotate(-45deg);
+  border-left: 1.6px solid currentColor;
+  border-bottom: 1.6px solid currentColor;
+}
+
+/* Trust-Werte gedämpft: die Vertrauens-Anzeige tritt optisch zurück (KEINE Umbenennung, kein
+   neuer Text, kein Ring — die Vertrauenswert-Scheibe bleibt ausdrücklich draußen). */
+[data-theme="modern"] .kw-confidence {
+  opacity: 0.78;
+}
+
+/* Ladeblock und Ergebnisfläche (mega38 A): Antwort blendet weich ein — nur, wenn der Mensch
+   Bewegung nicht reduziert hat. Die Animation hängt an den KINDERN des immer gemounteten Ankers
+   (Warten, Fehler, Vertrag, Antwort, Lücke) — Scroll/Fokus-Verhalten bleibt unangetastet. */
+@media (prefers-reduced-motion: no-preference) {
+  [data-theme="modern"] [data-testid="ask-result-anchor"] > * {
+    animation: kw-rise var(--kw-motion-duration) var(--kw-motion-ease) both;
+  }
+}
+
+/* ------------------------------------------------------------------------------------------------
+   BLÖCKE F/G — Bibliothek und Validierung erhalten hier KEINE eigenen Regeln: sie erben die
+   Token (Papier/Karte/Linie/Trust-Töne) und die Sammler 1–3 (Kicker/Pills, Karten-Elevation,
+   Bewegungstakt). Der unbeschriftete Trust-Balken und die Trefferzeilen-Breite sind bekannte
+   offene Posten ANDERER Scheiben; die FacetFilter-Angleichung (SCRUM-425) ist Schnitt 1. */
+
+@keyframes kw-rise {
+  from {
+    opacity: 0;
+    transform: translateY(4px);
+  }
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
diff --git a/apps/web/src/styles/themes.css b/apps/web/src/styles/themes.css
new file mode 100644
index 0000000000000000000000000000000000000000..9c2972ae502b6974348e12b644173f1378bff713
--- /dev/null
+++ b/apps/web/src/styles/themes.css
@@ -0,0 +1,153 @@
+/* ================================================================================================
+   AUFTRAG-mega40 BLOCK A — DIE ZENTRALE TOKEN-DATEI (beide Themes).
+   ================================================================================================
+
+   Diese Datei ist die EINE Farb-Wahrheit der Web-Oberfläche. tailwind.config.ts bildet seine
+   Farbnamen auf diese Custom Properties ab (rgb(var(--kw-…) / <alpha-value>)); es gibt dort keine
+   Hex-Werte mehr (Sammler: tests/app/mega40-token-disziplin.test.ts).
+
+   · :root  = KLASSISCH — die heutigen Werte, unverändert aus dem Bestand (tailwind.config.ts,
+     Stand d3fe69d) extrahiert, NICHT neu erfunden. Ohne data-theme-Attribut ändert sich kein
+     einziger berechneter Wert (Pin: tests/app/mega40-theme-invarianz.test.ts).
+   · [data-theme="modern"] = die Werkbank-Palette (DESIGN-V2-Vorschlag, Pedi 28.07.). Alle
+     modern-Regeln (styles/modern.css) hängen ausschließlich unter diesem Attribut.
+
+   Format: RGB-Kanäle („R G B"), damit Tailwinds Alpha-Modifier (z. B. border-ink/30, border-ai/50)
+   weiter funktionieren. Der Hex-Wert steht als Kommentar daneben.
+
+   Form-Token: Kartenradius 13px und Knopf-/Eingaberadius 9px (tailwind.config.ts borderRadius)
+   liegen BEREITS im Werkbank-Zielband (12–14 px / 9 px) — sie bleiben unangetastet in Tailwind. */
+
+:root {
+  /* Flächen und Tinte */
+  --kw-page: 243 244 246; /* #f3f4f6 */
+  --kw-surface: 255 255 255; /* #ffffff */
+  --kw-ink: 22 34 44; /* #16222c */
+  --kw-text: 27 30 33; /* #1b1e21 */
+  --kw-text-soft: 35 39 43; /* #23272b */
+  /* AUFTRAG-mega62 Block D: #687078 → #636b73. Auf Weiß (5,03:1) und Seite (4,57:1) reichte der
+     alte Wert; auf --kw-hairline-soft (#f0f1f3) lag er bei 4,448:1 — und genau DIESE Paarung trägt
+     der Hinweisbanner (bg-hairline-soft + text-muted), also die Pflichtfläche aus Artikel 50 der
+     KI-Verordnung. Absatz 5 verlangt dort ausdrücklich Barrierefreiheit. Neu: 4,79:1 auf
+     hairline-soft, 4,92:1 auf der Seite, 5,41:1 auf Weiß. Die Rangfolge zu --kw-muted-2 bleibt
+     erhalten (muted-2 ist weiterhin das dunklere Kleintext-Token). */
+  --kw-muted: 99 107 115; /* #636b73 (≥4,5:1 auch auf hairline-soft — mega62 D) */
+  --kw-muted-2: 97 106 114; /* #616a72 (E2E-014: ≥4,5:1 auf Weiß und Seite) */
+  --kw-hairline: 228 231 234; /* #e4e7ea */
+  --kw-hairline-soft: 240 241 243; /* #f0f1f3 */
+
+  /* Marke */
+  --kw-brand: 237 125 14; /* #ED7D0E */
+  --kw-brand-300: 245 160 74; /* #f5a04a */
+  /* AUFTRAG-mega62 Block D (Register F27): #a8560a → #9c5009. Der alte Wert erfüllte AA auf Weiß
+     (5,25:1) und auf der Seite (4,77:1), lag aber auf der Markenfläche --kw-funke-soft (#FDEADD)
+     bei 4,497:1 — knapp DARUNTER, weshalb diese Fläche für Markentext unbenutzbar war. Neu:
+     5,05:1 auf funke-soft, 5,89:1 auf Weiß, 5,35:1 auf der Seite, 5,56:1 auf modernem Papier. */
+  --kw-brand-text: 156 80 9; /* #9c5009 (Text-Token, ≥4,5:1 auch auf funke-soft — mega62 D) */
+
+  /* Trust — nur Reife/Status */
+  --kw-trust-pos-text: 37 107 70; /* #256b46 */
+  --kw-trust-pos-fill: 58 160 106; /* #3aa06a */
+  --kw-trust-pos-bg: 226 241 232; /* #e2f1e8 */
+  /* AUFTRAG-mega62 Block D: #9a6a12 → #8f620f. Auf der eigenen Fläche --kw-trust-warn-bg lag der
+     alte Wert bei 4,201:1 und auf der Seite bei 4,294:1 — beides unter AA. Diese Paarung trägt den
+     Entwurfsvermerk der beiden Rechtsseiten, den Hinweis nach einer Ablehnung auf der
+     Anmeldemaske und die Sperrfläche aus Block C; überall hängt eine Pflichtangabe daran.
+     Neu: 4,76:1 auf der eigenen Fläche, 4,87:1 auf der Seite, 5,36:1 auf Weiß. */
+  --kw-trust-warn-text: 143 98 15; /* #8f620f (≥4,5:1 auch auf trust-warn-bg — mega62 D) */
+  --kw-trust-warn-fill: 200 134 26; /* #c8861a */
+  --kw-trust-warn-bg: 250 241 219; /* #faf1db */
+  --kw-trust-crit-text: 158 53 46; /* #9e352e */
+  --kw-trust-crit-fill: 192 71 63; /* #c0473f */
+  --kw-trust-crit-bg: 248 231 229; /* #f8e7e5 */
+  --kw-trust-info-text: 28 93 112; /* #1c5d70 */
+  --kw-trust-info-bg: 228 238 241; /* #e4eef1 */
+
+  /* KI — nur Reasoner/KI (Farb-Disziplin aus BRIEF §3 bleibt) */
+  --kw-ai: 91 80 196; /* #5b50c4 */
+  --kw-ai-light: 157 147 240; /* #9d93f0 */
+  --kw-ai-surface-1: 236 235 251; /* #ecebfb */
+  --kw-ai-surface-2: 246 244 253; /* #f6f4fd */
+  --kw-ai-dashed: 185 178 236; /* #b9b2ec */
+
+  /* Elevation — die heutigen Schatten, wörtlich */
+  --kw-shadow-popover: 0 14px 40px rgba(16, 24, 32, 0.16);
+  --kw-shadow-tile: 0 1px 3px rgba(16, 24, 32, 0.14);
+
+  /* Schrift-Spiegel (Kicker-Sammler in modern.css braucht den Sans-Stapel als Token; der
+     Invarianz-Test pinnt, dass dieser Spiegel und tailwind fontFamily nicht auseinanderlaufen). */
+  --kw-font-sans: "IBM Plex Sans", system-ui, sans-serif;
+  --kw-font-mono: "IBM Plex Mono", ui-monospace, monospace;
+}
+
+/* ================================================================================================
+   MODERN — „Werkbank statt Verwaltung": Papier, Nacht und ein Funke.
+   Nur Variablen-Überschreibungen und modern-eigene Zusatz-Token. KEINE Regeln auf Elemente hier —
+   die wohnen in styles/modern.css, ebenfalls ausschließlich unter [data-theme="modern"]. */
+[data-theme="modern"] {
+  /* Flächen und Tinte */
+  --kw-page: 250 248 245; /* Papier #FAF8F5 */
+  --kw-surface: 255 255 255; /* Karte #FFFFFF */
+  --kw-ink: 14 22 38; /* Nacht #0E1626 */
+  --kw-text: 26 34 51; /* Tinte #1A2233 */
+  --kw-text-soft: 26 34 51; /* #1A2233 */
+  --kw-muted: 82 91 107; /* Tinte-2 #525B6B */
+  /* Tinte-3 (#8B93A2) der Palette ist für 10–11px-Metatexte zu hell (≈2,9:1 auf Weiß — dieselbe
+     Falle wie E2E-014). Für Text bleibt Tinte-2; #8B93A2 existiert unten als --kw-ink-3 für
+     nicht-textliche Verwendung. */
+  --kw-muted-2: 82 91 107; /* #525B6B */
+  --kw-hairline: 233 229 222; /* Linie #E9E5DE */
+  --kw-hairline-soft: 242 239 234; /* Linie, Richtung Papier aufgehellt (#F2EFEA) */
+
+  /* Marke: der Funke */
+  --kw-brand: 232 99 10; /* Funke #E8630A */
+  --kw-brand-300: 240 164 104; /* Funke hell #F0A468 (Werkbank-Vorlage, Hero-Kicker) */
+  /* --kw-brand-text wird hier ABSICHTLICH NICHT überschrieben — das moderne Thema erbt den
+     klassischen Wert. Funke dunkel (#C2500A) misst auf Papier nur 4,45:1 und fiele knapp unter AA
+     für Kleintext (Messung: tests/app/mega40-kontrast-modern.test.ts); #C2500A dient deshalb als
+     Knopf-Fläche (--kw-funke-deep).
+     AUFTRAG-mega63 Block C — KORREKTUR DIESES KOMMENTARS: Bis hierher stand „bleibt ABSICHTLICH
+     klassisch (#a8560a)". Der Klammerwert war seit mega62 D falsch — dort wurde der klassische
+     Token auf #9c5009 verdunkelt, und weil das moderne Thema ERBT, ist er hier mitgewandert.
+     Genau diese stille Mitwanderung war der Kontrastbefund in der modernen Seitenleiste. Ein
+     Kommentar, der einen geerbten Wert als festen ausgibt, verdeckt jede solche Bewegung; deshalb
+     nennt er jetzt die Erbschaft und keinen Zahlenwert, der ein zweites Mal veralten könnte. */
+
+  /* Trust in Werkbank-Tönen */
+  --kw-trust-pos-text: 17 107 60; /* Gesichert #116B3C */
+  --kw-trust-pos-fill: 17 107 60; /* #116B3C */
+  --kw-trust-pos-bg: 224 241 231; /* Fläche #E0F1E7 */
+  --kw-trust-warn-text: 138 90 0; /* Warnung #8A5A00 */
+  --kw-trust-warn-fill: 138 90 0; /* #8A5A00 */
+  --kw-trust-warn-bg: 253 241 215; /* Fläche #FDF1D7 */
+  --kw-trust-crit-text: 161 38 38; /* Fehler #A12626 */
+  --kw-trust-crit-fill: 161 38 38; /* #A12626 */
+  --kw-trust-crit-bg: 251 230 230; /* Fläche #FBE6E6 */
+  /* info und ai: die Werkbank-Palette benennt keinen Ersatz — bewusst unverändert (keine zweite
+     Wahrheit erfinden; Violett bleibt die KI-Kennfarbe, bis eine Scheibe das entscheidet). */
+
+  /* Modern-eigene Zusatz-Token (nur von modern.css referenziert) */
+  --kw-night: 14 22 38; /* Nacht #0E1626 */
+  --kw-night-2: 22 33 58; /* Nacht-Abstufung #16213A */
+  --kw-ink-3: 139 147 162; /* Tinte-3 #8B93A2 (nicht für Kleintext — s. o.) */
+  --kw-shell-fg: 250 248 245; /* Papier-Inhalt auf Nachtblau */
+  --kw-shell-muted: 185 193 210; /* #B9C1D2 (Werkbank-Vorlage, Hero-Fließtext) */
+  --kw-shell-muted-2: 126 135 154; /* #7E879A (Werkbank-Vorlage, Meta) */
+  --kw-funke-deep: 194 80 10; /* Funke dunkel #C2500A — Knopf-Fläche, Weiß darauf 4,72:1 */
+  --kw-funke-soft: 253 234 221; /* Funke Fläche #FDEADD */
+
+  /* Elevation: weiches Licht statt harter Rahmen (Werkbank-Vorlage --shadow) */
+  --kw-shadow-tile: 0 1px 2px rgb(var(--kw-night) / 0.05), 0 8px 24px -12px
+    rgb(var(--kw-night) / 0.12);
+  --kw-shadow-popover: 0 14px 40px rgb(var(--kw-night) / 0.16);
+
+  /* Bewegung: 150–200 ms, ein ruhiges Aus-Schwingen */
+  --kw-motion-duration: 180ms;
+  --kw-motion-ease: cubic-bezier(0.2, 0.7, 0.3, 1);
+
+  /* Kicker/Etiketten verlieren die Mono-Versalien-Anmutung (BLOCK C) — die Werte dazu als Token */
+  --kw-kicker-font: var(--kw-font-sans);
+  --kw-kicker-weight: 600;
+  --kw-kicker-tracking: 0.02em;
+  --kw-kicker-transform: none;
+}
