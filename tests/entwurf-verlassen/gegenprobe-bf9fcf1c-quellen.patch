+    label: string;
+    url?: string;
+    excerpt?: string;
+    sourceProvider?: string;
+    anchorKey?: string;
+    objectId?: string;
+  }[];
+  /**
+   * AUFTRAG-mega20 Block D — DIE GESICHERTEN ORIGINALE des Entwurfs.
