+  private normalizeTaskConfig(
+    next: ReasonerTaskConfigEingabe,
+    bisher?: ReasonerKiFreigabe | undefined,
+  ): {
+    config: ReasonerTaskConfig;
+    migration: ReasonerPolicyMigration | undefined;
+  } {
