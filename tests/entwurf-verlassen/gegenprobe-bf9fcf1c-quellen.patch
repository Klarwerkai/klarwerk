+  qc = client;
+  await act(async () => {
+    root?.render(
+      createElement(
+        QueryClientProvider,
+        { client },
+        createElement(MemoryRouter, { initialEntries: [pfad] }, createElement(App)),
+      ),
+    );
+    await flush();
+  });
