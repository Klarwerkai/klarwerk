+      </div>
+      <p className="text-[11.5px] text-muted-2">{t("enrich.disclaimer")}</p>
+
+      {/* Quelle umschalten: Modellwissen ODER belegte Web-Suche. */}
+      <div className="flex flex-wrap gap-1.5">
+        {(["model", "web"] as const).map((m) => (
