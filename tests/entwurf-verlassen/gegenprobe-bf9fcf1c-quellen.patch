+        proposals: offen.map((p) => (p.id === proposalId ? uebernommen : p)),
+      };
+      return {
+        updated,
+        value: { ko: updated, proposal: uebernommen },
+        // Der Snapshot nennt den EINREICHER als Urheber der Fassung (er hat den Text geschrieben);
