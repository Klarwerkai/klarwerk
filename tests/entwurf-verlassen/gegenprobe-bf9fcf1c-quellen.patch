+      at: null,
+      token: snapshotTokenCounter,
+      promise,
+    };
+    snapshot = entry;
+    promise.then(
+      (result) => {
+        // Erfolg: TTL läuft AB JETZT (nicht ab Scan-Start); Snapshot für Apply-Läufe festhalten.
+        if (snapshot === entry) {
+          entry.at = Date.now();
+        }
