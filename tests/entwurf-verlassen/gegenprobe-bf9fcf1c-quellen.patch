+
+const RICHTUNG_KURZ: Record<KantenRichtung, string> = {
+  gerichtet: "wb.richtungKurz.gerichtet",
+  ungerichtet: "wb.richtungKurz.ungerichtet",
+  symmetrisch: "wb.richtungKurz.symmetrisch",
