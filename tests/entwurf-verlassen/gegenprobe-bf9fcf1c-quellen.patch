+:root {
+  --ink: #1a1c1e;
+  --muted: #5b6168;
+  --muted-2: #878d94;
+  --line: #e3e6e9;
+  --page: #f6f7f8;
+  --surface: #ffffff;
+  --ai: #2f6db3;
+  --ai-bg: #eef4fb;
+  --pos: #2f7d4f;
+  --pos-bg: #eaf5ee;
+  --warn: #b0691f;
+  --warn-bg: #fbf1e5;
+  --crit: #b23b34;
+  --crit-bg: #fbeceb;
+  --status: #7a5aa8;
+  --status-bg: #f2edf9;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  font-family: -apple-system, "Segoe UI", system-ui, sans-serif;
+  font-size: 13px;
+  color: var(--ink);
+  background: var(--page);
+}
+
+.pane {
+  padding: 14px 14px 20px;
+  max-width: 420px;
+  margin: 0 auto;
+}
+
+.head .brand {
+  font-size: 17px;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+}
+.brand-2 {
+  color: var(--ai);
+  font-weight: 600;
+}
+.purpose {
+  margin: 2px 0 0;
+  color: var(--muted);
+  font-size: 12.5px;
+}
+
+.config {
+  margin: 14px 0 10px;
+}
+.lbl {
+  display: block;
+  font-size: 10px;
+  text-transform: uppercase;
+  letter-spacing: 0.06em;
+  color: var(--muted-2);
+  margin-bottom: 4px;
+}
+.inp {
+  width: 100%;
+  padding: 8px 10px;
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  background: var(--surface);
+  font-size: 13px;
+  color: var(--ink);
+  font-family: ui-monospace, "SF Mono", Menlo, monospace;
+}
+.presets {
+  display: flex;
+  gap: 6px;
+  margin-top: 6px;
+}
+.chip {
+  border: 1px solid var(--line);
