+          <span className="inline-flex items-center gap-1.5 text-[12px] font-semibold text-muted">
+            <Users size={13} /> {t("imp.explore.authors")}
+            {/* WP-SAMMEL20-FIX (bens Fix 6b): der Server liefert Top-N — ehrlich beziffert. */}
