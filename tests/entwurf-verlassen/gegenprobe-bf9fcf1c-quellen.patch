+
+export function Menue({
+  name,
+  offen,
+  setOffen,
+  wort,
+  beschriftung,
+  symbol,
+  gerahmt = false,
+  gesperrt = false,
+  titel,
+  markiert = false,
+  beschriebenVon,
+  ungueltig = false,
+  children,
+  pruefname,
