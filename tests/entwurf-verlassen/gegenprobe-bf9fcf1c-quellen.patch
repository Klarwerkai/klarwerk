+    expect(r.configStatus().policySource).toBe("env"); // weiterhin gesperrt
+  });
+
+  it("ohne ENV: setTaskConfig funktioniert wie bisher, policySource wechselt danach auf 'db'", async () => {
+    const repo = new InMemoryReasonerPolicyRepo();
