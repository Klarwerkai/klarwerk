+        kind: "attachment",
+        attachmentId: attachment.id,
+        ...(attachment.objectId ? { objectId: attachment.objectId } : {}),
+        label: attachment.name,
+        mime: attachment.mime,
+        createdBy: author,
+        createdAt: at,
+      });
