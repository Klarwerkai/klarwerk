+              {info.rationale}
+            </PruefenMehrBlock>
+          ) : null}
+          {redigiert ? (
+            <PruefenMehrBlock beschriftung={t("dup.redacted.title")}>
+              {t("dup.redacted.body")}
+            </PruefenMehrBlock>
+          ) : null}
+          {e.aspects.length > 0 ? (
+            <PruefenMehrBlock beschriftung={t("dup.shared")}>
+              <ul className="space-y-1.5">
+                {e.aspects.map((a, i) => (
+                  <li key={`${e.id}-aspect-${seite}-${a.zitatA}-${i}`}>
