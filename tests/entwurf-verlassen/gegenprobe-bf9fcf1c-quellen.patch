+  }
+
+  private async runTask<T extends { demo: boolean }>(
+    task: ModelRunTask,
+    locale: ReasonerLocale,
+    run: (provider: ReasonerProvider) => Promise<T>,
+    // SCRUM-502 Schicht 2: vertraulicher Eingabetext → Cloud aus der Kette (siehe providerChain).
