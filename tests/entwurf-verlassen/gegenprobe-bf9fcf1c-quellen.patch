+/** Die Beschriftung des Aufrufers fuer Protokoll, Beleg und Wissenslücke — nie fuer Eigentum. */
+function aufruferBeschriftung(aufrufer: AskCaller): string {
+  return aufrufer.kind === "system" ? SYSTEM_ACTOR : aufrufer.userId;
+}
