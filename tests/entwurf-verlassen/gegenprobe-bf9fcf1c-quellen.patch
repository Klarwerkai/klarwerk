+  } | null>(null);
+  const busy =
+    dismiss.isPending || keepSeparate.isPending || linkRelated.isPending || setStatus.isPending;
+
+  // SCRUM-486 (nacht24 Paket 3): dieselbe Reihenfolge wie bisher — Befunde desselben Beitrags
