+
+  it("A-7: KALIBRIERUNG — ein einzelner gefüllter Ahn ergibt genau ein Segment", () => {
+    // Ohne diesen Fall wäre jedes „ist undefined" oben auch dann grün, wenn die Funktion
+    // grundsätzlich nie einen Pfad liefert.
