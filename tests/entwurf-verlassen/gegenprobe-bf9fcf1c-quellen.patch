+{
+  "schema_version": 1,
+  "package_id": "advisor-ict-en-v1",
+  "updated_at": "2026-09-08T14:26:12+02:00",
+  "languages": ["de", "en"],
+  "notice": {
+    "de": "Fiktives Vorführmaterial für Advisor ICT. Diese internen Abläufe und Kundendaten sind erfunden und beschreiben keine tatsächlichen Regeln von Advisor.",
+    "en": "Fictional demonstration material prepared for Advisor ICT. These are invented internal procedures and customer details, not statements of actual Advisor policy."
+  },
+  "rule": "Reading variants, not independent evidence or new approvals. Do not import this translation catalogue as knowledge.",
+  "records": [
+    {
+      "key": "S01",
+      "semantic_id": "S01",
+      "original_language": "en",
+      "confluence_id": "25067523",
+      "confluence_url": "https://klarwerk.atlassian.net/wiki/spaces/K/pages/25067523/DEMO+S01+Customer+brief+Harbor+Field+Services",
+      "source_body_sha256": "4b48691d63375999a6e6227b6cc7b337c3ab10ffc6d6dd03b5f6504729a73673",
+      "translation_status": "draft_translation_not_business_approval",
+      "en": {
+        "title": "Customer brief: Harbor Field Services",
+        "paragraphs": [
+          "Harbor Field Services is a fictional customer with 25 office users and one branch. It wants a reliable Microsoft 365 workplace, guest Wi-Fi and a clear route to support.",
+          "The account manager records the requested outcome, the current problem and the person authorised to approve the purchase. A request is not an accepted order.",
+          "The first delivery covers the agreed workplace setup and branch network handover. Later improvements need their own scope decision."
+        ]
+      },
+      "de": {
