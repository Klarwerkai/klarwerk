+      findCandidates: async () => {
+        throw new Error("db down");
+      },
+    } as unknown as KoService;
+    const res = await checkKnowledge("Bei Kaltstart die Vorwärmung aktivieren.", {
+      ko: brokenKo,
+      conflicts: conflicts(),
+      judge: spyJudge(null).judge,
