+/** Was zuletzt gemessen wurde — der Stoff, aus dem der Kasten seine Anzeige baut. */
+interface KiFehlerstand {
+  readonly befund: KiTestBefund;
+  readonly detail: string | null;
+  readonly zeit: string | null;
+}
