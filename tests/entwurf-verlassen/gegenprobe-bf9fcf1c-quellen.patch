+    expect(scans).toBe(1);
+    // Drei schnelle Live-Filter-Änderungen → KEIN weiterer Vollscan (Filter auf dem Snapshot).
+    for (const criteria of [{}, { themes: ["Wartung"] }, { yearFrom: 2020 }]) {
