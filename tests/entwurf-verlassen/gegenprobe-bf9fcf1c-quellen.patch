+    expect(params[spalten.indexOf("generation")]).toBe(12);
+  });
+
+  it("eine V1-RÜCKSCHREIBUNG im Betrieb fällt den Marker — in DERSELBEN Transaktion", async () => {
+    const { pool, calls } = fakePool([{ ko_id: "k1" }], FREIGEGEBEN_V2);
