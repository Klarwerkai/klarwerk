+        // machen. Sie stehen im Erfolgsdatensatz unten, falls ein späteres Glied noch antwortet.
+        versuchsfehler.push(
+          `${provider.name}${versuchsModell ? ` (${versuchsModell})` : ""}: ${
+            err instanceof Error ? err.message : String(err)
+          }`,
+        );
