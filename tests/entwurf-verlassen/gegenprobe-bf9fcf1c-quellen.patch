+/** Die beiden Schalter der Adminfreigabe — genau der Rumpf, den `PUT /api/reasoner/config` kennt. */
+interface KiFreigabeStand {
+  readonly oeffentlicheKi: boolean;
+  readonly vertraulicheInhalte: boolean;
