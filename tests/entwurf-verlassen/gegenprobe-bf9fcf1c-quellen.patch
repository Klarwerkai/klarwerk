+  return (
+    <div className="mt-3 space-y-2 rounded-card border border-dashed border-ai/40 bg-ai-surface-1/40 p-3">
+      <div className="flex items-center gap-1.5">
+        <SectionLabel>{t("enrich.title")}</SectionLabel>
