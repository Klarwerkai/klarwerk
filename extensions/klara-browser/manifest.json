{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.4.1",
  "minimum_chrome_version": "120",
  "default_locale": "de",
  "permissions": ["activeTab", "contextMenus", "scripting", "sidePanel", "storage"],
  "optional_permissions": ["clipboardRead"],
  "host_permissions": ["https://app.klarwerk.ai/*"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_title": "__MSG_capture__" },
  "side_panel": { "default_path": "panel.html" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+K" }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://app.klarwerk.ai; base-uri 'none'; form-action 'none'"
  }
}
