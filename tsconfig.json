{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "outDir": "dist"
  },
  "include": ["services", "tests"],
  // WP-D8b: gemountete React-Tests (.tsx, jsdom) brauchen jsx+DOM-lib — die hat NUR der App-Build
  // (apps/web/tsconfig). Der Root-Check bleibt Node-rein. Teil C3: die .tsx-Tests laufen jetzt durch
  // ihren EIGENEN Typecheck (tsconfig.tests-tsx.json, im tools/build-Gate) — keine Gate-Schuld mehr.
  // AUFTRAG-mega50: die Grenze verläuft an `.tsx`, nicht mehr an `.test.tsx`. Auch ein HELFER dieser
  // Tests braucht jsx (er montiert React-Bauteile) — vorher fiel er in den Node-reinen Check und war
  // dort nicht typisierbar.
  // Klara 04 (produkt:20261008:klara-vorschlaege): `uebernahme-logik.test.ts` prüft
  // `apps/web/src/lib/klaraUebernahme.ts`, das DOMParser/TreeWalker benutzt — Typcheck daher mit
  // DOM-lib in `tsconfig.tests-tsx.json`, nicht hier.
  // Klara 05 (produkt:20261008:klara-aktionen): `zusammenfassen-zitatdeckung.test.ts` prüft den
  // Frage-Rahmen über `apps/web/src/components/klara-vorschau/bezug.ts`, das DOMParser benutzt —
  // aus demselben Grund dort geprüft, nicht hier.
  // Die OCR-Engine-Probe importiert files.ts mit FileReader/Image/document und gehört ebenfalls
  // in den bestehenden DOM-Typecheck (tsconfig.tests-tsx.json).
  "exclude": [
    "node_modules",
    "dist",
    "tests/**/*.tsx",
    "tests/types",
    "tests/klara-vorschlaege/uebernahme-logik.test.ts",
    "tests/klara-aktionen/zusammenfassen-zitatdeckung.test.ts",
    "tests/capture/ocr-engine-gleiche-herkunft.test.ts"
  ]
}
